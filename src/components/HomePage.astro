---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Faq from './Faq.astro';
import { CATEGORY_IDS, TOOLS } from '../data/tools';
import { websiteSchema, webAppSchema, faqSchema } from '../lib/jsonld';
import { getShell, localizeTool } from '../i18n';
import { fill } from '../i18n/inline';
import { localeMeta, localePath, type Locale } from '../i18n/locales';
import { SITE } from '../data/site';

interface Props {
  locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const { ui, home } = getShell(locale);
const lang = localeMeta(locale).hreflang;
const tools = TOOLS.map((t) => localizeTool(t.slug, locale)!);

const jsonLd = [
  websiteSchema({ description: home.description, inLanguage: lang }),
  webAppSchema(SITE.name, home.appBlurb, {
    url: new URL(localePath(locale, '/'), SITE.url).href,
    inLanguage: lang,
    os: ui.schemaOs,
    browser: ui.schemaBrowser,
    features: ui.features,
  }),
  faqSchema(home.faqs, lang),
];

const FEATURED_SLUGS = ['mp4-to-mp3', 'audio-trimmer'];
const POPULAR_SLUGS = ['audio-joiner', 'mp3-cutter', 'voice-recorder', 'increase-volume'];
const featured = FEATURED_SLUGS.map((slug) => tools.find((t) => t.slug === slug)!);
const popular = POPULAR_SLUGS.map((slug) => tools.find((t) => t.slug === slug)!);
const categoryIcon = { cut: 'scissors', merge: 'layers', record: 'mic', effects: 'waveform' } as const;
// Decorative hero waveform: deterministic heights, selection highlighted in accent
const heroBars = Array.from({ length: 75 }, (_, i) => 14 + Math.abs(Math.sin(i * 1.7)) * 46 + (i % 5) * 3);
const heroSel = [21, 47] as const;
---

<Base title={home.title} description={home.description} path="/" locale={locale} jsonLd={jsonLd}>
  <section class="container-page pb-12 pt-14 md:pb-16 md:pt-20">
    <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 text-xs font-medium text-ink2">
      <Icon name="shield-check" size={14} class="text-accent" />
      {home.badge}
    </p>
    <h1 class="mt-5 max-w-[16ch] text-4xl font-semibold leading-[1.05] tracking-tighter md:text-6xl">
      {home.h1}
    </h1>
    <p class="mt-5 max-w-[55ch] text-lg leading-relaxed text-ink2">
      {home.lede}
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href={localePath(locale, '/audio-trimmer')} class="btn btn-primary btn-lg">
        {home.ctaTrim}
        <Icon name="convert" size={18} />
      </a>
      <a href={localePath(locale, '/audio-joiner')} class="btn btn-secondary btn-lg">{home.ctaMerge}</a>
    </div>
    <div class="mt-10 max-w-2xl rounded-2xl border border-line bg-surface p-5 shadow-sm">
      <div class="flex items-center justify-between gap-3 text-xs text-ink3">
        <span class="inline-flex items-center gap-2 font-medium text-ink2">
          <Icon name="waveform" size={14} class="text-accent" />
          interview-raw.wav · 3:42
        </span>
        <span>MP3 · WAV · M4A · OGG · FLAC</span>
      </div>
      <svg viewBox="0 0 600 96" class="mt-4 h-20 w-full" preserveAspectRatio="none" aria-hidden="true">
        <rect
          x={heroSel[0] * 8 - 2}
          y="2"
          width={(heroSel[1] - heroSel[0] + 1) * 8 + 4}
          height="92"
          rx="8"
          class="fill-accent-soft"
        />
        {heroBars.map((h, i) => (
          <rect
            x={i * 8}
            y={48 - h / 2}
            width={5}
            height={h}
            rx={2.5}
            class:list={[i >= heroSel[0] && i <= heroSel[1] ? 'fill-accent' : 'fill-line']}
          />
        ))}
      </svg>
    </div>
  </section>

  <section id="tools" class="container-wide pb-16" aria-labelledby="tools-heading">
    <h2 id="tools-heading" class="text-2xl font-semibold tracking-tight md:text-3xl">{home.toolsHeading}</h2>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {
        featured.map((tool) => (
          <a
            href={localePath(locale, `/${tool.slug}`)}
            class="group relative flex flex-col rounded-xl border border-accent/60 bg-surface p-6 transition-colors hover:border-accent"
          >
            <span class="absolute right-5 top-5 inline-flex items-center gap-1.5 rounded-full bg-accent-soft px-2.5 py-1 text-[11px] font-medium text-accent">
              <Icon name="trending-up" size={12} />
              {home.mostUsed}
            </span>
            <span class="grid size-12 place-items-center rounded-xl bg-accent-soft text-accent">
              <Icon name={tool.icon} size={24} />
            </span>
            <h3 class="mt-5 text-lg font-medium group-hover:text-accent">{tool.name}</h3>
            <p class="mt-1.5 flex-1 text-sm leading-relaxed text-ink2">{tool.subtitle}</p>
            <p class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-accent">
              {fill(ui.openTool, { name: tool.name })}
              <Icon name="convert" size={15} class="transition-transform group-hover:translate-x-0.5" />
            </p>
          </a>
        ))
      }
    </div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        popular.map((tool) => (
          <a
            href={localePath(locale, `/${tool.slug}`)}
            class="group flex flex-col rounded-xl border border-line bg-surface p-5 transition-colors hover:border-accent"
          >
            <span class="grid size-10 place-items-center rounded-lg bg-accent-soft text-accent">
              <Icon name={tool.icon} size={20} />
            </span>
            <h3 class="mt-4 font-medium group-hover:text-accent">{tool.name}</h3>
            <p class="mt-1.5 line-clamp-2 flex-1 text-sm leading-relaxed text-ink2">{tool.cardLine ?? tool.subtitle}</p>
          </a>
        ))
      }
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        CATEGORY_IDS.map((cat) => {
          const count = TOOLS.filter((t) => t.category === cat).length;
          return (
            <a
              href={`${localePath(locale, '/tools')}#hub-${cat}`}
              class="group flex items-center gap-3 rounded-xl border border-line bg-surface p-5 transition-colors hover:border-accent"
            >
              <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-accent-soft text-accent">
                <Icon name={categoryIcon[cat]} size={20} />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block font-medium group-hover:text-accent">{ui.categories[cat]}</span>
                <span class="block text-sm text-ink3">{fill(home.toolsCount, { count })}</span>
              </span>
              <Icon name="convert" size={15} class="shrink-0 text-ink3 transition-transform group-hover:translate-x-0.5 group-hover:text-accent" />
            </a>
          );
        })
      }
    </div>
    <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2">
      <a href={localePath(locale, '/tools')} class="btn btn-secondary">
        {fill(home.allToolsCta, { count: TOOLS.length })}
        <Icon name="convert" size={16} />
      </a>
      <p class="text-sm text-ink3">
        <span class="font-medium text-ink2">{home.comingTitle}:</span> {home.comingBody}
      </p>
    </div>
  </section>

  <section class="border-y border-line bg-surface py-16" aria-labelledby="why-heading">
    <div class="container-page">
      <h2 id="why-heading" class="text-2xl font-semibold tracking-tight md:text-3xl">
        {home.whyHeading}
      </h2>
      <div class="mt-8 grid gap-8 md:grid-cols-[2fr_1fr_1fr]">
        {
          home.why.map((item, i) => (
            <div>
              <span class="grid size-11 place-items-center rounded-xl bg-accent-soft text-accent">
                <Icon name={i === 0 ? 'lock-simple' : i === 1 ? 'clock-counter-clockwise' : 'check'} size={22} />
              </span>
              <h3 class="mt-5 font-medium">{item.title}</h3>
              <p class:list={['mt-2 text-sm leading-relaxed text-ink2', i === 0 && 'max-w-[45ch]']}>{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Faq faqs={home.faqs} locale={locale} />
</Base>
