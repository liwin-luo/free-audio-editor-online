---
/**
 * Shared template for tool landing pages. Content uniqueness comes from the
 * ToolDef data (title, intro, how-to, FAQs) — structure stays consistent.
 */
import Base from '../layouts/Base.astro';
import AudioEditor from './editor/AudioEditor.astro';
import JoinerEditor from './editor/JoinerEditor.astro';
import VisualizerEditor from './editor/VisualizerEditor.astro';
import SpecPaintEditor from './editor/SpecPaintEditor.astro';
import TranscribeEditor from './editor/TranscribeEditor.astro';
import TagEditor from './editor/TagEditor.astro';
import LoudnessEditor from './editor/LoudnessEditor.astro';
import MixerEditor from './editor/MixerEditor.astro';
import VoiceRecorder from './editor/VoiceRecorder.astro';
import TrustBadge from './TrustBadge.astro';
import HowTo from './HowTo.astro';
import Faq from './Faq.astro';
import RelatedTools from './RelatedTools.astro';
import { webAppSchema, faqSchema, howToSchema, breadcrumbSchema } from '../lib/jsonld';
import { getShell } from '../i18n';
import { fill } from '../i18n/inline';
import { localeMeta, localePath, type Locale } from '../i18n/locales';
import { SITE } from '../data/site';
import type { ToolDef } from '../data/tools';

interface Props {
  tool: ToolDef;
  locale?: Locale;
}
const { tool, locale = 'en' } = Astro.props;
const { ui } = getShell(locale);
const pageUrl = new URL(localePath(locale, `/${tool.slug}`), SITE.url).href;
const lang = localeMeta(locale).hreflang;
const jsonLd = [
  webAppSchema(tool.name, tool.description, {
    url: pageUrl,
    inLanguage: lang,
    os: ui.schemaOs,
    browser: ui.schemaBrowser,
    features: ui.features,
  }),
  howToSchema(fill(ui.howTo, { name: tool.name }), tool.howTo, lang),
  faqSchema(tool.faqs, lang),
  breadcrumbSchema([
    { name: ui.home, path: localePath(locale, '/') },
    { name: tool.name, path: localePath(locale, `/${tool.slug}`) },
  ]),
];
---

<Base title={tool.title} description={tool.description} path={`/${tool.slug}`} locale={locale} jsonLd={jsonLd}>
  <div class="container-page">
    <nav aria-label="Breadcrumb" class="pt-5 text-xs">
      <a href={localePath(locale, '/')} class="text-ink3 hover:text-accent">{ui.home}</a>
      <span class="mx-1.5 text-ink3">/</span>
      <span class="text-ink2" aria-current="page">{tool.name}</span>
    </nav>

    <section class="pt-4">
      <div class="flex items-center gap-3">
        {
          tool.hero && (
            <img
              src={tool.hero.src}
              alt={tool.hero.alt}
              width={tool.hero.width}
              height={tool.hero.height}
              decoding="async"
              class="size-8 shrink-0 md:size-9"
            />
          )
        }
        <h1 class="text-3xl font-semibold tracking-tight md:text-4xl">{tool.h1}</h1>
      </div>
      <p class="mt-2 text-[15px] text-ink2 md:text-base">{tool.subtitle}</p>
    </section>

    <section class="mt-6" aria-label={`${tool.name}`}>
      {tool.recorder && <VoiceRecorder locale={locale} />}
      {tool.editor.paint ? (
        <SpecPaintEditor config={tool.editor} locale={locale} />
      ) : tool.editor.visualizer ? (
        <VisualizerEditor config={tool.editor} locale={locale} />
      ) : tool.editor.transcribe ? (
        <TranscribeEditor config={tool.editor} locale={locale} />
      ) : tool.editor.tagEditor ? (
        <TagEditor config={tool.editor} locale={locale} />
      ) : tool.editor.loudness ? (
        <LoudnessEditor config={tool.editor} locale={locale} />
      ) : tool.editor.mixer ? (
        <MixerEditor config={tool.editor} locale={locale} />
      ) : tool.editor.multiple ? (
        <JoinerEditor config={tool.editor} locale={locale} />
      ) : (
        <AudioEditor config={tool.editor} locale={locale} />
      )}
    </section>

    <div class="mt-5">
      <TrustBadge locale={locale} />
    </div>

    <section class="pt-14">
      <p class="max-w-[70ch] text-[17px] leading-relaxed text-ink2">{tool.intro}</p>
      <div class="mt-8 max-w-[70ch]">
        <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">{tool.usesHeading}</h2>
        <ul class="mt-3 space-y-2.5 text-[15px] leading-relaxed text-ink2">
          {
            tool.uses.map((item) => (
              <li class="flex gap-3">
                <span class="mt-[0.55rem] size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </div>

  <HowTo title={fill(ui.howTo, { name: tool.name })} steps={tool.howTo} />

  {
    tool.sections && tool.sections.length > 0 && (
      <div class="container-page">
        <section class="pb-16">
          {tool.sections.map((section, i) => (
            <div class:list={['max-w-[70ch]', i === 0 ? 'mt-0' : 'mt-10']}>
              <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">{section.heading}</h2>
              {section.paragraphs?.map((paragraph) => (
                <p class="mt-3 text-[15px] leading-relaxed text-ink2">{paragraph}</p>
              ))}
              {section.bullets && (
                <ul class="mt-3 space-y-2.5 text-[15px] leading-relaxed text-ink2">
                  {section.bullets.map((item) => (
                    <li class="flex gap-3">
                      <span class="mt-[0.55rem] size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </section>
      </div>
    )
  }
  <Faq faqs={tool.faqs} locale={locale} heading={fill(ui.toolFaq, { name: tool.name })} />
  <RelatedTools current={tool} locale={locale} />
</Base>
