---
/**
 * Shared template for tool landing pages. Content uniqueness comes from the
 * ToolDef data (title, intro, how-to, FAQs) — structure stays consistent.
 */
import Base from '../layouts/Base.astro';
import AudioEditor from './editor/AudioEditor.astro';
import JoinerEditor from './editor/JoinerEditor.astro';
import VisualizerEditor from './editor/VisualizerEditor.astro';
import MusicVisualizerEditor from './editor/MusicVisualizerEditor.astro';
import SpecPaintEditor from './editor/SpecPaintEditor.astro';
import TranscribeEditor from './editor/TranscribeEditor.astro';
import MidiEditor from './editor/MidiEditor.astro';
import TagEditor from './editor/TagEditor.astro';
import LoudnessEditor from './editor/LoudnessEditor.astro';
import MetronomeEditor from './editor/MetronomeEditor.astro';
import SoundboardEditor from './editor/SoundboardEditor.astro';
import KeyBpmEditor from './editor/KeyBpmEditor.astro';
import MixerEditor from './editor/MixerEditor.astro';
import VoiceRecorder from './editor/VoiceRecorder.astro';
import TrustBadge from './TrustBadge.astro';
import HowTo from './HowTo.astro';
import Faq from './Faq.astro';
import RelatedTools from './RelatedTools.astro';
import Icon from './Icon.astro';
import { webAppSchema, faqSchema, howToSchema, breadcrumbSchema } from '../lib/jsonld';
import { getShell } from '../i18n';
import { fill } from '../i18n/inline';
import { localeMeta, localePath, type Locale } from '../i18n/locales';
import { SITE } from '../data/site';
import { guidesForTool, GUIDE_INDEX } from '../data/guides';
import { TOOL_FACTS } from '../data/tool-facts';
import type { ToolDef } from '../data/tools';

interface Props {
  tool: ToolDef;
  locale?: Locale;
}
const { tool, locale = 'en' } = Astro.props;
const { ui } = getShell(locale);
const facts = locale === 'en' ? TOOL_FACTS[tool.slug] : undefined;
const pageUrl = new URL(localePath(locale, `/${tool.slug}`), SITE.url).href;
const lang = localeMeta(locale).hreflang;
const guides = guidesForTool(tool.slug, locale);
const guideMinutes = GUIDE_INDEX[locale].minutes;
const jsonLd = [
  webAppSchema(tool.name, tool.description, {
    url: pageUrl,
    inLanguage: lang,
    os: ui.schemaOs,
    browser: ui.schemaBrowser,
    features: ui.features,
  }),
  howToSchema(fill(ui.howTo, { name: tool.name }), tool.howTo, lang),
  faqSchema(tool.faqs, lang),
  breadcrumbSchema([
    { name: ui.home, path: localePath(locale, '/') },
    { name: ui.tools, path: localePath(locale, '/tools') },
    { name: ui.categories[tool.category], path: localePath(locale, `/tools/${tool.category}`) },
    { name: tool.name, path: localePath(locale, `/${tool.slug}`) },
  ]),
];
---

<Base title={tool.title} description={tool.description} path={`/${tool.slug}`} locale={locale} jsonLd={jsonLd}>
  <div class="container-page">
    <nav aria-label="Breadcrumb" class="pt-5 text-xs">
      <a href={localePath(locale, '/')} class="text-ink3 hover:text-accent">{ui.home}</a>
      <span class="mx-1.5 text-ink3">/</span>
      <a href={localePath(locale, '/tools')} class="text-ink3 hover:text-accent">{ui.tools}</a>
      <span class="mx-1.5 text-ink3">/</span>
      <a href={localePath(locale, `/tools/${tool.category}`)} class="text-ink3 hover:text-accent">{ui.categories[tool.category]}</a>
      <span class="mx-1.5 text-ink3">/</span>
      <span class="text-ink2" aria-current="page">{tool.name}</span>
    </nav>

    <section class="pt-4">
      <div class="flex items-center gap-3">
        {
          tool.hero && (
            <img
              src={tool.hero.src}
              alt={tool.hero.alt}
              width={tool.hero.width}
              height={tool.hero.height}
              decoding="async"
              class="size-8 shrink-0 md:size-9"
            />
          )
        }
        <h1 class="text-3xl font-semibold tracking-tight md:text-4xl">{tool.h1}</h1>
      </div>
      <p class="mt-2 text-[15px] text-ink2 md:text-base">{tool.subtitle}</p>
    </section>

    <section class="mt-6" aria-label={`${tool.name}`}>
      {tool.recorder && <VoiceRecorder locale={locale} />}
      {tool.editor.paint ? (
        <SpecPaintEditor config={tool.editor} locale={locale} />
      ) : tool.editor.visualizer === 'live' ? (
        <MusicVisualizerEditor config={tool.editor} locale={locale} />
      ) : tool.editor.visualizer ? (
        <VisualizerEditor config={tool.editor} locale={locale} />
      ) : tool.editor.transcribe ? (
        <TranscribeEditor config={tool.editor} locale={locale} />
      ) : tool.editor.midi ? (
        <MidiEditor config={tool.editor} locale={locale} />
      ) : tool.editor.tagEditor ? (
        <TagEditor config={tool.editor} locale={locale} />
      ) : tool.editor.keyBpm ? (
        <KeyBpmEditor config={tool.editor} locale={locale} />
      ) : tool.editor.metronome ? (
        <MetronomeEditor config={tool.editor} locale={locale} />
      ) : tool.editor.soundboard ? (
        <SoundboardEditor config={tool.editor} locale={locale} />
      ) : tool.editor.loudness ? (
        <LoudnessEditor config={tool.editor} locale={locale} />
      ) : tool.editor.mixer ? (
        <MixerEditor config={tool.editor} locale={locale} />
      ) : tool.editor.multiple ? (
        <JoinerEditor config={tool.editor} locale={locale} />
      ) : (
        <AudioEditor config={tool.editor} locale={locale} />
      )}
    </section>

    <div class="mt-5">
      <TrustBadge locale={locale} offline={!tool.editor.transcribe && !tool.editor.midi} />
    </div>

    <section class="pt-14">
      <p class="max-w-[65ch] text-[17px] leading-relaxed text-ink2">{tool.intro}</p>
      <div class="mt-8 max-w-[65ch]">
        <h2 class="text-[28px] font-semibold tracking-tight">{tool.usesHeading}</h2>
        <ul class="mt-3 space-y-2.5 text-[15px] leading-relaxed text-ink2">
          {
            tool.uses.map((item) => (
              <li class="flex gap-3">
                <span class="mt-[0.55rem] size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {
      facts && (
        <>
          <section class="pt-12" aria-labelledby="tool-fit-heading">
            <h2 id="tool-fit-heading" class="text-[28px] font-semibold tracking-tight">
              Where this page fits
            </h2>
            <div class="mt-6 grid gap-4 md:grid-cols-2">
              <div class="rounded-2xl border border-line bg-surface p-6">
                <p class="flex items-center gap-2 text-sm font-semibold">
                  <Icon name="check" size={16} class="text-accent" />
                  Use it for
                </p>
                <ul class="mt-4 space-y-3 text-[15px] leading-relaxed text-ink2">
                  {facts.fit.use.map((item) => (
                    <li class="flex gap-3">
                      <span class="mt-[0.55rem] size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div class="rounded-2xl border border-line bg-surface p-6">
                <p class="flex items-center gap-2 text-sm font-semibold">
                  <Icon name="x" size={16} class="text-ink3" />
                  Use another page for
                </p>
                <ul class="mt-4 space-y-3 text-[15px] leading-relaxed text-ink2">
                  {facts.fit.avoid.map((item) => (
                    <li class="flex gap-3">
                      <span class="mt-[0.55rem] size-1.5 shrink-0 rounded-full bg-ink3" aria-hidden="true" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </section>

          <section class="pt-12" aria-labelledby="tool-specs-heading">
            <h2 id="tool-specs-heading" class="text-[28px] font-semibold tracking-tight">
              Formats, limits and privacy
            </h2>
            <div class="mt-6 overflow-hidden rounded-2xl border border-line">
              <table class="w-full border-collapse text-start text-sm">
                <caption class="sr-only">{tool.name}: formats, limits and privacy</caption>
                <tbody>
                  {facts.specs.map((spec) => (
                    <tr class="border-t border-line first:border-t-0">
                      <th scope="row" class="w-[34%] bg-surface px-5 py-3.5 align-top font-medium text-ink3">
                        {spec.label}
                      </th>
                      <td class="px-5 py-3.5 align-top leading-relaxed text-ink2">{spec.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        </>
      )
    }
  </div>

  <HowTo title={fill(ui.howTo, { name: tool.name })} steps={tool.howTo} />

  {
    tool.sections && tool.sections.length > 0 && (
      <div class="container-page">
        <section class="pb-16">
          {tool.sections.map((section, i) => (
            <div class:list={['max-w-[65ch]', i === 0 ? 'mt-0' : 'mt-10']}>
              <h2 class="text-[28px] font-semibold tracking-tight">{section.heading}</h2>
              {section.paragraphs?.map((paragraph) => (
                <p class="mt-3 text-[15px] leading-relaxed text-ink2">{paragraph}</p>
              ))}
              {section.bullets && (
                <ul class="mt-3 space-y-2.5 text-[15px] leading-relaxed text-ink2">
                  {section.bullets.map((item) => (
                    <li class="flex gap-3">
                      <span class="mt-[0.55rem] size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </section>
      </div>
    )
  }
  <Faq faqs={tool.faqs} locale={locale} heading={fill(ui.toolFaq, { name: tool.name })} />

  {
    guides.length > 0 && (
      <section class="py-16" aria-labelledby="tool-guides-heading">
        <div class="container-page">
          <h2 id="tool-guides-heading" class="text-[28px] font-semibold tracking-tight">
            {ui.guides}
          </h2>
          <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {guides.map((guide) => (
              <a
                href={guide.href}
                class="group flex flex-col rounded-xl border border-line bg-surface p-6 transition-colors hover:border-accent"
              >
                <h3 class="font-medium leading-snug group-hover:text-accent">{guide.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-ink2">{guide.description}</p>
                <p class="mt-4 text-sm font-medium text-accent">
                  {guide.minutes} {guideMinutes}
                </p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <RelatedTools current={tool} locale={locale} />
</Base>
