---
/**
 * Inline SVG icon set — 24x24, stroke 1.5, round caps (Phosphor-style geometry).
 * Usage: <Icon name="scissors" size={20} />
 * No emoji, no icon font, zero JS.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 20, class: className = '' } = Astro.props;

const icons: Record<string, string> = {
  trimmer:
    '<path d="M4 7h10M4 17h10"/><path d="M14 7c2.5 0 4 2.2 4 5s-1.5 5-4 5"/><circle cx="6" cy="7" r="2"/><circle cx="6" cy="17" r="2"/>',
  scissors:
    '<circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><path d="M8.2 7.8 20 18M8.2 16.2 20 6"/>',
  waveform:
    '<path d="M3 12h2M7 8v8M11 4v16M15 7v10M19 10v4M21 11v2"/>',
  bell: '<path d="M6 10a6 6 0 0 1 12 0c0 4 1.5 5.5 2 6H4c.5-.5 2-2 2-6Z"/><path d="M10 19a2 2 0 0 0 4 0"/>',
  layers:
    '<path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 13 9 5 9-5"/><path d="m3 17 9 5 9-5"/>',
  convert:
    '<path d="M4 8h13l-3-3M20 16H7l3 3"/>',
  reverse:
    '<path d="M4 8h12a4 4 0 0 1 0 8h-2"/><path d="M8 4 4 8l4 4"/>',
  volume:
    '<path d="M4 10v4h3l5 4V6l-5 4H4Z"/><path d="M16 9a4 4 0 0 1 0 6"/><path d="M18.5 6.5a8 8 0 0 1 0 11"/>',
  mic: '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>',
  film: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 4v16M17 4v16"/><path d="M3 9h4M3 15h4M17 9h4M17 15h4"/>',
  'shield-check':
    '<path d="M12 3 5 6v5c0 4.5 3 8.5 7 10 4-1.5 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>',
  'upload-simple':
    '<path d="M12 16V5M8 9l4-4 4 4"/><path d="M4 17v2a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-2"/>',
  'download-simple':
    '<path d="M12 5v11M8 12l4 4 4-4"/><path d="M4 17v2a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-2"/>',
  play: '<path d="M8 5.5v13l10-6.5-10-6.5Z"/>',
  pause: '<path d="M8 5v14M16 5v14"/>',
  moon: '<path d="M20 13.5A8 8 0 0 1 10.5 4 8 8 0 1 0 20 13.5Z"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"/>',
  'caret-down': '<path d="m6 9 6 6 6-6"/>',
  'arrow-up': '<path d="M12 19V5M6 11l6-6 6 6"/>',
  'arrow-down': '<path d="M12 5v14M6 13l6 6 6-6"/>',
  x: '<path d="M6 6l12 12M18 6 6 18"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  minus: '<path d="M5 12h14"/>',
  check: '<path d="m5 13 4 4L19 7"/>',
  'warning-triangle':
    '<path d="M12 4 2.5 20h19L12 4Z"/><path d="M12 10v4M12 17.5v.5"/>',
  'lock-simple': '<rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  'arrow-arc-left': '<path d="M8 5 3 10l5 5"/><path d="M3 10h11a6 6 0 0 1 6 6v2"/>',
  'clock-counter-clockwise':
    '<path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/><path d="M12 8v4l3 2"/>',
  'cursor-click': '<path d="m9 9 10 4-4.5 1.5L13 19 9 9Z"/><path d="M4 4h.01M9 3v.01M3 9h.01"/>',
  'trending-up': '<path d="m3 17 6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
};
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
  set:html={icons[name] ?? icons['waveform']}
/>
