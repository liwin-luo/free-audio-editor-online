---
/**
 * The shared drop-well front door: a large ringed icon and the drop hint.
 * Slot it inside <DropPromise>; pair it with a LocalBadge rendered the same
 * way for every island. Side ornaments were tried and removed per user
 * review (2026-11-07) — keep the well quiet so the upload action reads first.
 */
import Icon from '../Icon.astro';

interface Props {
  icon: string;
  hint: string;
}
const { icon, hint } = Astro.props;
---

<div
  data-open
  tabindex="0"
  role="button"
  aria-label={hint}
  class="group relative flex w-full flex-col items-center overflow-hidden rounded-2xl px-6 py-5 md:py-7"
>
  <span
    class="relative z-10 mx-auto grid size-14 place-items-center rounded-2xl bg-accent-soft text-accent ring-4 ring-accent/10 transition-transform duration-200 group-hover:scale-105"
  >
    <Icon name={icon} size={26} />
  </span>
  <p class="relative z-10 mt-3 text-base font-semibold">{hint}</p>
</div>
