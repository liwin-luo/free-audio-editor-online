---
/**
 * Key and BPM island. Reads a file. Does not change it.
 */
import Icon from '../Icon.astro';
import { getShell } from '../../i18n';
import type { Locale } from '../../i18n/locales';
import type { EditorConfig } from '../../data/tools';

interface Props {
  config: EditorConfig;
  locale?: Locale;
}
const { config, locale = 'en' } = Astro.props;
const { editor: t } = getShell(locale);
---

<div
  data-key-bpm
  data-i18n={JSON.stringify(t)}
  class="overflow-hidden rounded-(--radius-tool) border border-line bg-surface"
>
  <div data-empty>
  <div
    data-dropzone
    class="mx-4 mt-4 cursor-pointer rounded-xl border border-dashed border-line px-6 py-10 text-center md:mx-5 md:py-12"
  >
    <div data-open tabindex="0" role="button" aria-label={config.dropHint}>
      <span class="mx-auto grid size-10 place-items-center rounded-xl bg-accent-soft text-accent">
        <Icon name="upload-simple" size={20} />
      </span>
      <p class="mt-3 text-base font-semibold">{config.dropHint}</p>
    </div>
  </div>
  <div class="mb-5 mt-4 text-center">
    <p class="inline-flex items-center gap-2 rounded-full bg-surface2 px-4 py-1.5 text-xs text-ink2">
      <Icon name="shield-check" size={14} class="text-accent" />
      {t.dropLocal}
    </p>
  </div>
  </div>
  <input type="file" class="hidden" accept={config.accept ?? 'audio/*,video/mp4,.m4a,.opus'} data-file-input />

  <div data-workspace class="hidden">
    <div class="flex items-center justify-between gap-3 border-b border-line px-4 py-2.5 md:px-5">
      <div class="min-w-0">
        <p data-file-name class="truncate text-sm font-medium"></p>
        <p data-file-meta class="font-mono text-xs text-ink3"></p>
      </div>
      <button type="button" class="btn btn-secondary h-9 shrink-0 px-3 text-sm" data-reset>
        {t.changeFile}
      </button>
    </div>

    <div class="grid gap-6 px-4 py-6 sm:grid-cols-2 md:px-5">
      <div>
        <p class="text-sm text-ink2">BPM</p>
        <p data-key-bpm-bpm class="mt-1 font-mono text-4xl font-semibold tabular-nums tracking-tight">—</p>
      </div>
      <div>
        <p class="text-sm text-ink2">{t.keyTonic}</p>
        <p data-key-bpm-key class="mt-1 font-mono text-4xl font-semibold tracking-tight">—</p>
      </div>
    </div>
    <p class="px-4 pb-5 text-sm text-ink2 md:px-5">{t.keyCaveat}</p>
  </div>
</div>

<div data-toast-root class="pointer-events-none fixed inset-x-4 top-20 z-50 flex flex-col items-center gap-2 md:inset-x-auto md:bottom-6 md:left-auto md:right-6 md:top-auto md:items-end"></div>

<script>
  import { initKeyBpm } from '../../editor/key-bpm-ui';

  initKeyBpm();
</script>
