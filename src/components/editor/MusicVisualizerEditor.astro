---
/**
 * Live music visualizer island: animated spectrum playback + video recording.
 * Static, SEO-friendly markup; src/editor/music-visualizer-ui.ts wires it up.
 * The canvas renders at export resolution and CSS scales it down for preview,
 * so MediaRecorder captures the exact pixels the user sees.
 */
import Icon from '../Icon.astro';
import LocalBadge from './LocalBadge.astro';
import DropPromise from './DropPromise.astro';
import { getShell } from '../../i18n';
import type { Locale } from '../../i18n/locales';
import type { EditorConfig } from '../../data/tools';

interface Props {
  config: EditorConfig;
  locale?: Locale;
}
const { config, locale = 'en' } = Astro.props;
const { editor: t } = getShell(locale);
---

<div
  data-music-visualizer
  data-config={JSON.stringify(config)}
  data-i18n={JSON.stringify(t)}
  class="overflow-clip rounded-(--radius-tool) border border-line bg-surface"
>
  <div data-empty>
  <DropPromise config={config} locale={locale}>
    <div data-open tabindex="0" role="button" aria-label={config.dropHint}>
      <span class="mx-auto grid size-10 place-items-center rounded-xl bg-accent-soft text-accent">
        <Icon name="film" size={20} />
      </span>
      <p class="mt-3 text-base font-semibold">{config.dropHint}</p>
    </div>
  </DropPromise>
  <LocalBadge text={t.dropLocal} />
  </div>
  <input type="file" class="hidden" accept={config.accept ?? 'audio/*,video/mp4,.m4a,.opus'} data-file-input />

  <!-- Workspace: visible after a file is loaded -->
  <div data-workspace class="hidden">
    <!-- File bar -->
    <div class="flex items-center justify-between gap-3 border-b border-line px-4 py-2.5 md:px-5">
      <div class="flex min-w-0 items-center gap-3">
        <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-accent-soft text-accent">
          <Icon name="film" size={16} />
        </span>
        <div class="min-w-0">
          <p data-file-name class="truncate text-sm font-medium"></p>
          <p data-file-meta class="font-mono text-xs text-ink3"></p>
        </div>
      </div>
      <button type="button" class="btn btn-secondary h-9 shrink-0 px-3 text-sm" data-reset>
        {t.changeFile}
      </button>
    </div>

    <!-- Preview stage: the canvas IS the export surface -->
    <div data-stage class="flex justify-center overflow-hidden bg-surface2/40 p-4 md:p-5">
      <canvas data-canvas class="max-h-[300px] max-w-full rounded-lg md:max-h-[360px]" style="aspect-ratio: 16 / 9" aria-hidden="true"></canvas>
    </div>

    <!-- Play row -->
    <div class="flex items-center gap-3 border-b border-line px-4 py-2.5 md:px-5">
      <button type="button" class="btn btn-secondary h-9 px-4 text-sm" data-play disabled></button>
      <span data-time class="font-mono text-xs tabular-nums text-ink3">0:00 / 0:00</span>
    </div>

    <!-- Look controls -->
    <div class="grid gap-x-6 gap-y-4 border-b border-line px-4 py-3.5 sm:grid-cols-2 md:px-5 lg:grid-cols-3">
      <label class="block text-sm text-ink2">
        {t.mvStyle}
        <select data-mv-style class="mt-1.5 h-10 w-full rounded-lg border border-line-strong bg-bg px-2.5 text-sm text-ink">
          <option value="bars" selected>{t.mvStyleBars}</option>
          <option value="mirrored">{t.mvStyleMirrored}</option>
          <option value="ring">{t.mvStyleRing}</option>
          <option value="scope">{t.mvStyleScope}</option>
        </select>
      </label>
      <label class="block text-sm text-ink2">
        {t.mvTheme}
        <select data-mv-theme class="mt-1.5 h-10 w-full rounded-lg border border-line-strong bg-bg px-2.5 text-sm text-ink">
          <option value="neon" selected>{t.mvThemeNeon}</option>
          <option value="synthwave">{t.mvThemeSynthwave}</option>
          <option value="fire">{t.mvThemeFire}</option>
          <option value="ocean">{t.mvThemeOcean}</option>
          <option value="matrix">{t.mvThemeMatrix}</option>
          <option value="midnight">{t.mvThemeMidnight}</option>
          <option value="paper">{t.mvThemePaper}</option>
          <option value="">{t.vizTemplateNone}</option>
        </select>
      </label>
      <label class="block text-sm text-ink2">
        {t.mvPrimary}
        <input type="color" data-mv-primary value="#22d3ee" class="mt-1.5 h-10 w-full cursor-pointer rounded-lg border border-line-strong bg-bg p-1" />
      </label>
      <label class="block text-sm text-ink2">
        {t.vizBgColor}
        <input type="color" data-mv-bg value="#020617" class="mt-1.5 h-10 w-full cursor-pointer rounded-lg border border-line-strong bg-bg p-1" />
      </label>
      <label class="block text-sm text-ink2">
        {t.vizSize}
        <select data-mv-size class="mt-1.5 h-10 w-full rounded-lg border border-line-strong bg-bg px-2.5 text-sm text-ink">
          <option value="landscape" data-w="1920" data-h="1080" selected>{t.mvSizeLandscape} · 1920×1080</option>
          <option value="portrait" data-w="1080" data-h="1920">{t.mvSizePortrait} · 1080×1920</option>
          <option value="square" data-w="1080" data-h="1080">{t.vizSizeSquare} · 1080×1080</option>
          <option value="custom">{t.vizSizeCustom}</option>
        </select>
      </label>
      <div data-mv-custom-row class="hidden items-end gap-3 text-sm text-ink2">
        <label class="block">
          {t.vizWidth}
          <input type="number" data-mv-w value="1280" min="200" max="2160" step="10" class="mt-1.5 h-10 w-24 rounded-lg border border-line-strong bg-bg px-2.5 font-mono text-sm tabular-nums text-ink" />
        </label>
        <label class="block">
          {t.vizHeight}
          <input type="number" data-mv-h value="720" min="200" max="2160" step="10" class="mt-1.5 h-10 w-24 rounded-lg border border-line-strong bg-bg px-2.5 font-mono text-sm tabular-nums text-ink" />
        </label>
      </div>
    </div>

    <p data-mv-note class="hidden border-b border-line px-4 py-3 text-sm text-ink2 md:px-5" role="note"></p>

    <!-- Export bar -->
    <div class="export-bar flex-wrap">
      <p class="text-xs text-ink3">{t.mvRealtime}</p>
      <div class="ms-auto flex items-center gap-2">
        <button type="button" class="btn btn-secondary hidden h-11 px-4 text-sm" data-cancel>{t.mvCancel}</button>
        <button type="button" class="btn btn-primary btn-lg" data-export disabled>
          <Icon name="film" size={18} />
          <span data-export-label>{config.exportLabel ?? t.export}</span>
        </button>
      </div>
    </div>
  </div>

  <p data-status class="sr-only" role="status" aria-live="polite"></p>

  <div data-toast-root class="toast-root"></div>
</div>

<script>
  import { initMusicVisualizers } from '../../editor/music-visualizer-ui';
  initMusicVisualizers();
</script>
