---
/**
 * Transcription island for the audio-to-text tool. Static, SEO-friendly
 * markup; src/editor/transcribe.ts wires it up. The product is text —
 * no waveform and no audio export, unlike the other islands.
 */
import Icon from '../Icon.astro';
import LocalBadge from './LocalBadge.astro';
import DropPromise from './DropPromise.astro';
import { getShell } from '../../i18n';
import type { Locale } from '../../i18n/locales';
import type { EditorConfig } from '../../data/tools';

interface Props {
  config: EditorConfig;
  locale?: Locale;
}
const { config, locale = 'en' } = Astro.props;
const { editor: t } = getShell(locale);
---

<div
  data-transcribe
  data-config={JSON.stringify(config)}
  data-i18n={JSON.stringify(t)}
  class="overflow-clip rounded-(--radius-tool) border border-line bg-surface"
>
  <div data-empty>
  <DropPromise config={config} locale={locale}>
    <div data-open tabindex="0" role="button" aria-label={config.dropHint}>
      <span class="mx-auto grid size-10 place-items-center rounded-xl bg-accent-soft text-accent">
        <Icon name="voice" size={20} />
      </span>
      <p class="mt-3 text-base font-semibold">{config.dropHint}</p>
    </div>
  </DropPromise>
  <LocalBadge text={t.dropLocal} />
  </div>
  <input type="file" class="hidden" accept={config.accept ?? 'audio/*,video/mp4,.m4a,.opus'} data-file-input {...(config.batch ? { multiple: true } : {})} />

  <!-- Workspace: visible after a file is loaded -->
  <div data-workspace class="hidden">
    <!-- File bar -->
    <div class="flex items-center justify-between gap-3 border-b border-line px-4 py-2.5 md:px-5">
      <div class="flex min-w-0 items-center gap-3">
        <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-accent-soft text-accent">
          <Icon name="voice" size={16} />
        </span>
        <div class="min-w-0">
          <p data-file-name class="truncate text-sm font-medium"></p>
          <p data-file-meta class="font-mono text-xs text-ink3"></p>
        </div>
      </div>
      <button type="button" class="btn btn-secondary h-9 shrink-0 px-3 text-sm" data-reset>
        {t.changeFile}
      </button>
    </div>
    <ul data-batch-list class="hidden max-h-36 list-disc overflow-auto border-b border-line px-8 py-2 text-xs leading-5 text-ink2"></ul>

    <!-- Controls -->
    <div class="grid gap-x-6 gap-y-4 border-b border-line px-4 py-3.5 sm:grid-cols-2 md:px-5">
      <label class="block text-sm text-ink2">
        {t.trLang}
        <select data-language class="mt-1.5 h-10 w-full rounded-lg border border-line-strong bg-bg px-2.5 text-sm text-ink">
          <option value="" selected>{t.trLangAuto}</option>
        </select>
      </label>
      <label class="block text-sm text-ink2">
        {t.trModel}
        <select data-model class="mt-1.5 h-10 w-full rounded-lg border border-line-strong bg-bg px-2.5 text-sm text-ink">
          <option value="base">{t.trModelBase}</option>
          <option value="tiny">{t.trModelTiny}</option>
        </select>
      </label>
    </div>

    <!-- Progress -->
    <div data-progress-row class="hidden border-b border-line px-4 py-3 md:px-5">
      <div class="h-1.5 w-full overflow-hidden rounded-full bg-surface2">
        <div data-progress-bar class="h-full w-full origin-inline-start rounded-full bg-accent transition-transform duration-300" style="transform: scaleX(0)"></div>
      </div>
    </div>

    <!-- Output -->
    <div class="px-4 py-3.5 md:px-5">
      <textarea
        data-transcript
        rows={9}
        disabled
        placeholder={t.trResultPlaceholder}
        class="w-full resize-y rounded-lg border border-line-strong bg-bg px-3 py-2.5 text-sm leading-relaxed text-ink placeholder:text-ink3 disabled:cursor-not-allowed"
      ></textarea>
      <p class="mt-2 text-xs text-ink3">{t.trFirstRun}</p>
    </div>

    <!-- Action bar -->
    <div class="export-bar flex-wrap">
      <p class="text-xs text-ink3">{t.dropLocal}</p>
      <div class="ms-auto flex flex-wrap items-center gap-2">
        <button type="button" class="btn btn-ghost" data-copy disabled>{t.trCopy}</button>
        <button type="button" class="btn btn-ghost" data-download-txt disabled>{t.trTxt}</button>
        <button type="button" class="btn btn-ghost" data-download-srt disabled>{t.trSrt}</button>
        <button type="button" class="btn btn-primary btn-lg" data-transcribe-btn disabled>
          <Icon name="voice" size={18} />
          <span>{config.exportLabel ?? t.export}</span>
        </button>
      </div>
    </div>
  </div>

  <p data-status class="sr-only" role="status" aria-live="polite"></p>

  <div data-toast-root class="toast-root"></div>
</div>

<script>
  import { initTranscribers } from '../../editor/transcribe';
  initTranscribers();
</script>
