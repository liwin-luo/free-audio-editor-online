---
/**
 * MP3 tag editor island: form over ID3 tags + cover art. All strings are
 * server-rendered; the client script only moves file bytes. Config + runtime
 * strings ride in as JSON on data attributes (TranscribeEditor pattern).
 * The audio stream is never decoded — only the tag block is rewritten.
 */
import Icon from '../Icon.astro';
import { getShell } from '../../i18n';
import type { Locale } from '../../i18n/locales';
import type { EditorConfig } from '../../data/tools';

interface Props {
  config: EditorConfig;
  locale?: Locale;
}
const { config, locale = 'en' } = Astro.props;
const { editor: t } = getShell(locale);
const runtime = {
  readFail: t.tgReadFail,
  saving: t.tgSaving,
  saved: t.tgSaved,
  writeFail: t.tgWriteFail,
};
---

<div
  data-tag-editor
  data-config={JSON.stringify(config)}
  data-i18n={JSON.stringify(runtime)}
  class="overflow-hidden rounded-(--radius-tool) border border-line bg-surface"
>
  <!-- Empty state / dropzone -->
  <div data-dropzone class="cursor-pointer px-6 py-12 text-center md:py-16" tabindex="0" role="button" aria-label={config.dropHint}>
    <span class="mx-auto grid size-14 place-items-center rounded-2xl bg-accent-soft text-accent">
      <Icon name="tag" size={28} />
    </span>
    <p class="mt-5 text-lg font-medium">{config.dropHint}</p>
    <p class="mt-6 inline-flex items-center gap-2 rounded-full bg-surface2 px-4 py-1.5 text-xs text-ink2">
      <Icon name="shield-check" size={14} class="text-accent" />
      {t.dropLocal}
    </p>
    <input type="file" class="hidden" accept={config.accept ?? 'audio/mpeg,.mp3'} data-file-input />
  </div>

  <!-- Workspace: visible after a file is loaded -->
  <div data-workspace class="hidden">
    <!-- File bar -->
    <div class="flex items-center justify-between gap-3 border-b border-line px-4 py-2.5 md:px-5">
      <div class="flex min-w-0 items-center gap-3">
        <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-accent-soft text-accent">
          <Icon name="tag" size={16} />
        </span>
        <div class="min-w-0">
          <p data-file-name class="truncate text-sm font-medium"></p>
          <p data-file-meta class="font-mono text-xs text-ink3"></p>
        </div>
      </div>
      <button type="button" class="btn btn-ghost size-9 shrink-0 p-0" data-eject aria-label={t.loadDifferent} title={t.startOver}>
        <Icon name="arrow-arc-left" size={16} />
      </button>
    </div>

    <p data-notags class="hidden border-b border-line px-4 py-3 text-sm text-ink2 md:px-5">{t.tgNoTags}</p>

    <!-- Tag fields -->
    <fieldset data-fields class="grid gap-x-6 gap-y-4 border-b border-line px-4 py-3.5 sm:grid-cols-2 md:px-5">
      <label class="block text-sm text-ink2 sm:col-span-2">
        {t.tgTitle}
        <input data-field="title" type="text" autocomplete="off" class="mt-1.5 h-10 w-full rounded-lg border border-line bg-bg px-2.5 text-sm text-ink" />
      </label>
      <label class="block text-sm text-ink2">
        {t.tgArtist}
        <input data-field="artist" type="text" autocomplete="off" class="mt-1.5 h-10 w-full rounded-lg border border-line bg-bg px-2.5 text-sm text-ink" />
      </label>
      <label class="block text-sm text-ink2">
        {t.tgAlbum}
        <input data-field="album" type="text" autocomplete="off" class="mt-1.5 h-10 w-full rounded-lg border border-line bg-bg px-2.5 text-sm text-ink" />
      </label>
      <label class="block text-sm text-ink2">
        {t.tgAlbumArtist}
        <input data-field="albumArtist" type="text" autocomplete="off" class="mt-1.5 h-10 w-full rounded-lg border border-line bg-bg px-2.5 text-sm text-ink" />
      </label>
      <label class="block text-sm text-ink2">
        {t.tgYear}
        <input data-field="year" type="text" inputmode="numeric" maxlength="4" autocomplete="off" class="mt-1.5 h-10 w-full rounded-lg border border-line bg-bg px-2.5 text-sm text-ink" />
      </label>
      <label class="block text-sm text-ink2">
        {t.tgGenre}
        <input data-field="genre" type="text" autocomplete="off" class="mt-1.5 h-10 w-full rounded-lg border border-line bg-bg px-2.5 text-sm text-ink" />
      </label>
      <label class="block text-sm text-ink2">
        {t.tgTrack}
        <input data-field="track" type="text" autocomplete="off" class="mt-1.5 h-10 w-full rounded-lg border border-line bg-bg px-2.5 text-sm text-ink" />
      </label>
      <label class="block text-sm text-ink2">
        {t.tgDisc}
        <input data-field="disc" type="text" autocomplete="off" class="mt-1.5 h-10 w-full rounded-lg border border-line bg-bg px-2.5 text-sm text-ink" />
      </label>
      <label class="block text-sm text-ink2">
        {t.tgComposer}
        <input data-field="composer" type="text" autocomplete="off" class="mt-1.5 h-10 w-full rounded-lg border border-line bg-bg px-2.5 text-sm text-ink" />
      </label>
      <label class="block text-sm text-ink2 sm:col-span-2">
        {t.tgComment}
        <textarea data-field="comment" rows="2" class="mt-1.5 w-full resize-y rounded-lg border border-line bg-bg px-3 py-2.5 text-sm leading-relaxed text-ink"></textarea>
      </label>
    </fieldset>

    <!-- Cover art -->
    <section class="border-b border-line px-4 py-3.5 md:px-5">
      <h3 class="text-sm font-medium text-ink2">{t.tgCover}</h3>
      <div class="mt-2 flex items-start gap-4">
        <img data-cover-img alt="" class="size-24 shrink-0 rounded-lg border border-line object-cover" hidden />
        <div class="flex min-w-0 flex-col gap-2 text-sm">
          <div class="flex flex-wrap gap-2">
            <label class="btn btn-secondary cursor-pointer">
              {t.tgReplaceCover}
              <input type="file" accept="image/jpeg,image/png" class="hidden" data-cover-input />
            </label>
            <button type="button" class="btn btn-secondary" data-cover-remove>{t.tgRemoveCover}</button>
            <button type="button" class="btn btn-secondary" data-cover-save hidden>{t.tgSaveCover}</button>
          </div>
          <p class="text-xs text-ink3">{t.tgCoverHint}</p>
        </div>
      </div>
    </section>

    <!-- Remove-all mode -->
    <label class="flex items-center gap-3 border-b border-line px-4 py-3.5 text-sm text-ink2 md:px-5">
      <input type="checkbox" class="size-4 accent-(--color-accent)" data-remove-all />
      {t.tgRemoveAll}
    </label>

    <!-- Action bar -->
    <div class="sticky bottom-0 flex flex-wrap items-center gap-3 border-t border-line bg-surface/95 px-4 py-3 backdrop-blur md:px-5">
      <p class="text-xs text-ink3">{t.dropLocal}</p>
      <div class="ml-auto flex flex-wrap items-center gap-3">
        <p data-status class="text-sm text-ink2" aria-live="polite"></p>
        <button type="button" class="btn btn-ghost" data-reset>{t.tgReset}</button>
        <button type="button" class="btn btn-primary btn-lg" data-save disabled>
          <Icon name="download-simple" size={18} />
          <span>{config.exportLabel ?? t.export}</span>
        </button>
      </div>
    </div>
  </div>

  <div data-toast-root class="pointer-events-none fixed inset-x-4 top-20 z-50 flex flex-col items-center gap-2 md:inset-x-auto md:bottom-6 md:left-auto md:right-6 md:top-auto md:items-end"></div>
</div>

<script>
  import { buildTaggedMp3, parseId3, type AudioTags, type PictureData } from '../../editor/tags';
  import { formatBytes } from '../../lib/format';
  import { showToast } from '../../editor/messages';
  import type { EditorConfig } from '../../data/tools';

  /** Only the strings the controller needs at runtime; everything else is SSR. */
  interface TagRuntime {
    readFail: string;
    saving: string;
    saved: string;
    writeFail: string;
  }

  const TEXT_FIELDS = [
    'title',
    'artist',
    'album',
    'albumArtist',
    'year',
    'genre',
    'track',
    'disc',
    'composer',
    'comment',
  ] as const;
  type TextField = (typeof TEXT_FIELDS)[number];

  function requireEl<T extends Element>(root: ParentNode, selector: string): T {
    const el = root.querySelector<T>(selector);
    if (!el) throw new Error(`Tag editor markup missing: ${selector}`);
    return el;
  }

  function download(blob: Blob, name: string): void {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = name;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 5000);
  }

  class TagForm {
    private config: EditorConfig;
    private i18n: TagRuntime;
    private els: {
      dropzone: HTMLElement;
      fileInput: HTMLInputElement;
      workspace: HTMLElement;
      fileName: HTMLElement;
      fileMeta: HTMLElement;
      eject: HTMLButtonElement;
      notags: HTMLElement;
      fields: HTMLFieldSetElement;
      fieldsByName: Record<TextField, HTMLInputElement | HTMLTextAreaElement>;
      coverImg: HTMLImageElement;
      coverInput: HTMLInputElement;
      coverRemove: HTMLButtonElement;
      coverSave: HTMLButtonElement;
      removeAll: HTMLInputElement;
      save: HTMLButtonElement;
      reset: HTMLButtonElement;
      status: HTMLElement;
    };

    private audioBuf: ArrayBuffer | null = null;
    private parsed: AudioTags = {};
    private baseName = 'audio';
    private picture: PictureData | null = null;
    private coverUrl: string | null = null;
    private busy = false;

    constructor(root: HTMLElement) {
      this.config = JSON.parse(root.dataset.config ?? '{}') as EditorConfig;
      this.i18n = JSON.parse(root.dataset.i18n ?? '{}') as TagRuntime;
      const fieldsByName = {} as Record<TextField, HTMLInputElement | HTMLTextAreaElement>;
      for (const name of TEXT_FIELDS) {
        fieldsByName[name] = requireEl<HTMLInputElement | HTMLTextAreaElement>(root, `[data-field="${name}"]`);
      }
      this.els = {
        dropzone: requireEl(root, '[data-dropzone]'),
        fileInput: requireEl<HTMLInputElement>(root, '[data-file-input]'),
        workspace: requireEl(root, '[data-workspace]'),
        fileName: requireEl(root, '[data-file-name]'),
        fileMeta: requireEl(root, '[data-file-meta]'),
        eject: requireEl<HTMLButtonElement>(root, '[data-eject]'),
        notags: requireEl(root, '[data-notags]'),
        fields: requireEl<HTMLFieldSetElement>(root, '[data-fields]'),
        fieldsByName,
        coverImg: requireEl<HTMLImageElement>(root, '[data-cover-img]'),
        coverInput: requireEl<HTMLInputElement>(root, '[data-cover-input]'),
        coverRemove: requireEl<HTMLButtonElement>(root, '[data-cover-remove]'),
        coverSave: requireEl<HTMLButtonElement>(root, '[data-cover-save]'),
        removeAll: requireEl<HTMLInputElement>(root, '[data-remove-all]'),
        save: requireEl<HTMLButtonElement>(root, '[data-save]'),
        reset: requireEl<HTMLButtonElement>(root, '[data-reset]'),
        status: requireEl(root, '[data-status]'),
      };
      this.bind();
    }

    private bind(): void {
      const { els } = this;

      // 11. Drop zone: click, keyboard, drag & drop.
      els.dropzone.addEventListener('click', () => els.fileInput.click());
      els.dropzone.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          els.fileInput.click();
        }
      });
      for (const type of ['dragenter', 'dragover'] as const) {
        els.dropzone.addEventListener(type, (e) => {
          e.preventDefault();
          els.dropzone.classList.add('border-accent', 'bg-accent-soft');
        });
      }
      for (const type of ['dragleave', 'drop'] as const) {
        els.dropzone.addEventListener(type, (e) => {
          e.preventDefault();
          els.dropzone.classList.remove('border-accent', 'bg-accent-soft');
        });
      }
      els.dropzone.addEventListener('drop', (e) => {
        const file = e.dataTransfer?.files?.[0];
        if (file) void this.load(file);
      });
      els.fileInput.addEventListener('change', () => {
        const file = els.fileInput.files?.[0];
        if (file) void this.load(file);
        els.fileInput.value = '';
      });

      // 4. Replace / add cover art.
      els.coverInput.addEventListener('change', () => {
        const f = els.coverInput.files?.[0];
        els.coverInput.value = '';
        if (!f) return;
        if (f.type !== 'image/jpeg' && f.type !== 'image/png') {
          this.setStatus(this.i18n.readFail);
          showToast(this.toastRoot(), 'error', this.i18n.readFail);
          return;
        }
        void f.arrayBuffer().then((buf) => {
          this.picture = { data: new Uint8Array(buf), mime: f.type };
          this.refreshCover();
          this.setStatus('');
        });
      });

      // 5. Remove cover.
      els.coverRemove.addEventListener('click', () => {
        this.picture = null;
        this.refreshCover();
      });

      // 6. Save the current cover image.
      els.coverSave.addEventListener('click', () => {
        if (!this.picture) return;
        const ext = this.picture.mime === 'image/png' ? 'png' : 'jpg';
        download(new Blob([this.picture.data], { type: this.picture.mime }), `${this.baseName}.${ext}`);
      });

      // 7. Remove-all mode disables the tag fields; cover keeps working
      //    (buildTaggedMp3 ignores it in that mode).
      els.removeAll.addEventListener('change', () => {
        els.fields.disabled = els.removeAll.checked;
      });

      // 9. Save MP3.
      els.save.addEventListener('click', () => void this.save());

      // 10. Reset back to the parsed tags.
      els.reset.addEventListener('click', () => this.reset());

      // Load a different file (file-bar eject, island convention).
      els.eject.addEventListener('click', () => this.eject());
    }

    // 2. Load an MP3: read tags on-device, fill the form, show the cover.
    private async load(file: File): Promise<void> {
      if (this.busy) return;
      const isMp3 = file.type === 'audio/mpeg' || /\.mp3$/i.test(file.name);
      if (!isMp3) {
        this.setStatus(this.i18n.readFail);
        showToast(this.toastRoot(), 'error', this.i18n.readFail);
        return;
      }
      try {
        this.audioBuf = await file.arrayBuffer();
      } catch {
        this.audioBuf = null;
        this.setStatus(this.i18n.readFail);
        showToast(this.toastRoot(), 'error', this.i18n.readFail);
        return;
      }
      this.parsed = parseId3(new Uint8Array(this.audioBuf));
      this.baseName = file.name.replace(/\.[^.]+$/, '') || 'audio';
      this.els.fileName.textContent = file.name;
      this.els.fileMeta.textContent = formatBytes(file.size);
      this.picture = this.parsed.picture
        ? { data: this.parsed.picture.data, mime: this.parsed.picture.mime }
        : null;
      this.fillFrom(this.parsed);
      this.refreshCover();
      this.refreshNoTags();
      this.els.dropzone.hidden = true;
      this.els.workspace.classList.remove('hidden');
      this.els.save.disabled = false;
      this.setStatus('');
    }

    // 3. Reflect the current picture in the preview and the Save-cover button.
    private refreshCover(): void {
      const { els } = this;
      if (this.coverUrl) {
        URL.revokeObjectURL(this.coverUrl);
        this.coverUrl = null;
      }
      if (this.picture) {
        this.coverUrl = URL.createObjectURL(new Blob([this.picture.data], { type: this.picture.mime }));
        els.coverImg.src = this.coverUrl;
        els.coverImg.hidden = false;
        els.coverSave.hidden = false;
      } else {
        els.coverImg.removeAttribute('src');
        els.coverImg.hidden = true;
        els.coverSave.hidden = true;
      }
      this.refreshNoTags();
    }

    private refreshNoTags(): void {
      const p = this.parsed;
      const hasTags = Boolean(
        p.title || p.artist || p.album || p.albumArtist || p.year || p.genre || p.track || p.disc || p.composer || p.comment,
      );
      this.els.notags.hidden = hasTags || this.picture !== null;
    }

    // 8. Collect the form into AudioTags (trimmed; empty stays undefined).
    private collect(): AudioTags {
      const v = (name: TextField): string | undefined => {
        const t = this.els.fieldsByName[name].value.trim();
        return t ? t : undefined;
      };
      return {
        title: v('title'),
        artist: v('artist'),
        album: v('album'),
        albumArtist: v('albumArtist'),
        year: v('year'),
        genre: v('genre'),
        track: v('track'),
        disc: v('disc'),
        composer: v('composer'),
        comment: v('comment'),
        picture: this.picture ?? undefined,
      };
    }

    // 9. Build the tagged file (or bare audio) and hand it to the browser.
    private async save(): Promise<void> {
      const { els } = this;
      if (!this.audioBuf || this.busy) return;
      this.busy = true;
      els.save.disabled = true;
      this.setStatus(this.i18n.saving);
      try {
        const out = buildTaggedMp3(this.audioBuf, this.collect(), {
          removeAll: els.removeAll.checked,
        });
        const title = this.els.fieldsByName.title.value.trim();
        const safe = title.replace(/[\\/:*?"<>|]/g, '_') || 'audio';
        download(new Blob([out], { type: 'audio/mpeg' }), `${safe}.mp3`);
        this.setStatus(this.i18n.saved);
      } catch {
        this.setStatus(this.i18n.writeFail);
        showToast(this.toastRoot(), 'error', this.i18n.writeFail);
      } finally {
        this.busy = false;
        els.save.disabled = false;
      }
    }

    // 10. Reset: refill the form from the tags as they were parsed.
    private reset(): void {
      this.picture = this.parsed.picture
        ? { data: this.parsed.picture.data, mime: this.parsed.picture.mime }
        : null;
      this.fillFrom(this.parsed);
      this.refreshCover();
      this.setStatus('');
    }

    private fillFrom(tags: AudioTags): void {
      for (const name of TEXT_FIELDS) {
        this.els.fieldsByName[name].value = tags[name] ?? '';
      }
    }

    private eject(): void {
      this.audioBuf = null;
      this.parsed = {};
      this.picture = null;
      this.fillFrom({});
      this.refreshCover();
      this.els.workspace.classList.add('hidden');
      this.els.dropzone.hidden = false;
      this.els.save.disabled = true;
      this.els.fields.disabled = false;
      this.els.removeAll.checked = false;
      this.setStatus('');
    }

    private toastRoot(): HTMLElement | null {
      return document.querySelector<HTMLElement>('[data-toast-root]');
    }

    private setStatus(msg: string): void {
      this.els.status.textContent = msg;
    }
  }

  document.querySelectorAll<HTMLElement>('[data-tag-editor]').forEach((root) => {
    if (root.dataset.initialized) return;
    root.dataset.initialized = '1';
    new TagForm(root);
  });
</script>
