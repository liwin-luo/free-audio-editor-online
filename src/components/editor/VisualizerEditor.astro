---
/**
 * Visualizer island for image-output tools (waveform / spectrogram).
 * Static, SEO-friendly markup; src/editor/visualizer-ui.ts wires it up.
 * No audio-export UI — the product is a picture of the chosen time range.
 */
import Icon from '../Icon.astro';
import LocalBadge from './LocalBadge.astro';
import DropPromise from './DropPromise.astro';
import { getShell } from '../../i18n';
import type { Locale } from '../../i18n/locales';
import type { EditorConfig } from '../../data/tools';

interface Props {
  config: EditorConfig;
  locale?: Locale;
}
const { config, locale = 'en' } = Astro.props;
const { editor: t } = getShell(locale);
const isSpec = config.visualizer === 'spectrogram';
---

<div
  data-visualizer
  data-config={JSON.stringify(config)}
  data-i18n={JSON.stringify(t)}
  class="overflow-clip rounded-(--radius-tool) border border-line bg-surface"
>
  <div data-empty>
  <DropPromise config={config} locale={locale}>
    <div data-open tabindex="0" role="button" aria-label={config.dropHint}>
      <span class="mx-auto grid size-10 place-items-center rounded-xl bg-accent-soft text-accent">
        <Icon name="image" size={20} />
      </span>
      <p class="mt-3 text-base font-semibold">{config.dropHint}</p>
    </div>
  </DropPromise>
  <LocalBadge text={t.dropLocal} />
  </div>
  <input type="file" class="hidden" accept={config.accept ?? 'audio/*,video/mp4,.m4a,.opus'} data-file-input />

  <!-- Workspace: visible after a file is loaded -->
  <div data-workspace class="hidden">
    <!-- File bar -->
    <div class="flex items-center justify-between gap-3 border-b border-line px-4 py-2.5 md:px-5">
      <div class="flex min-w-0 items-center gap-3">
        <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-accent-soft text-accent">
          <Icon name="image" size={16} />
        </span>
        <div class="min-w-0">
          <p data-file-name class="truncate text-sm font-medium"></p>
          <p data-file-meta class="font-mono text-xs text-ink3"></p>
        </div>
      </div>
      <button type="button" class="btn btn-secondary h-9 shrink-0 px-3 text-sm" data-reset>
        {t.changeFile}
      </button>
    </div>

    <!-- Preview stage -->
    <div data-stage class="flex justify-center overflow-hidden bg-surface2/40 p-4 md:p-5" aria-label={isSpec ? t.specPreview : t.vizPreview}>
      <canvas data-preview class="max-h-[300px] max-w-full rounded-lg md:max-h-[360px]" style="aspect-ratio: 16 / 9" aria-hidden="true"></canvas>
    </div>

    <!-- Controls -->
    <div class:list={['grid gap-x-6 gap-y-4 border-b border-line px-4 py-3.5 sm:grid-cols-2 md:px-5 lg:grid-cols-3', isSpec && 'hidden']}>
      <label class:list={['block text-sm text-ink2', isSpec && 'hidden']}>
        {t.vizTemplate}
        <select data-viz-template class="mt-1.5 h-10 w-full rounded-lg border border-line-strong bg-bg px-2.5 text-sm text-ink">
          <option value="" selected>{t.vizTemplateNone}</option>
          <option value="soundcloud">{t.vizTplSoundcloud}</option>
          <option value="podcast">{t.vizTplPodcast}</option>
          <option value="poster">{t.vizTplPoster}</option>
          <option value="sticker">{t.vizTplSticker}</option>
          <option value="print">{t.vizTplPrint}</option>
          <option value="neon">{t.vizTplNeon}</option>
          <option value="blocks">{t.vizTplBlocks}</option>
        </select>
      </label>
      <label class:list={['block text-sm text-ink2', isSpec && 'hidden']}>
        {t.vizStyle}
        <select data-viz-style class="mt-1.5 h-10 w-full rounded-lg border border-line-strong bg-bg px-2.5 text-sm text-ink">
          <option value="bars" selected>{t.vizStyleBars}</option>
          <option value="filled">{t.vizStyleFilled}</option>
          <option value="outline">{t.vizStyleOutline}</option>
          <option value="dots">{t.vizStyleDots}</option>
          <option value="bottom">{t.vizStyleBottom}</option>
          <option value="blocks">{t.vizStyleBlocks}</option>
        </select>
      </label>
      <label class:list={['block text-sm text-ink2', isSpec && 'hidden']}>
        {t.vizWaveColor}
        <input type="color" data-viz-wave-color value="#0d9488" class="mt-1.5 h-10 w-full cursor-pointer rounded-lg border border-line-strong bg-bg p-1" />
      </label>
      <label class:list={['block text-sm text-ink2', isSpec && 'hidden']}>
        {t.vizBgColor}
        <input type="color" data-viz-bg-color value="#09090b" class="mt-1.5 h-10 w-full cursor-pointer rounded-lg border border-line-strong bg-bg p-1" />
      </label>
      <label class:list={['flex items-center gap-3 text-sm text-ink2', isSpec && 'hidden']}>
        <input type="checkbox" data-viz-transparent checked class="size-4 accent-(--color-accent)" />
        {t.vizTransparent}
      </label>
    </div>

    <div class:list={['grid gap-x-6 gap-y-4 border-b border-line px-4 py-3.5 sm:grid-cols-2 md:px-5 lg:grid-cols-3', !isSpec && 'hidden']}>
      <label class="block text-sm text-ink2">
        {t.specFft}
        <select data-viz-fft class="mt-1.5 h-10 w-full rounded-lg border border-line-strong bg-bg px-2.5 text-sm text-ink">
          <option value="1024">1024</option>
          <option value="2048" selected>2048</option>
          <option value="4096">4096</option>
        </select>
      </label>
      <label class="block text-sm text-ink2">
        {t.specAxis}
        <select data-viz-axis class="mt-1.5 h-10 w-full rounded-lg border border-line-strong bg-bg px-2.5 text-sm text-ink">
          <option value="log" selected>{t.specAxisLog}</option>
          <option value="linear">{t.specAxisLinear}</option>
        </select>
      </label>
      <label class="block text-sm text-ink2">
        {t.specMaxHz}
        <input type="number" data-viz-max-hz value="20000" min="200" max="96000" step="100" class="mt-1.5 h-10 w-full rounded-lg border border-line-strong bg-bg px-2.5 font-mono text-sm tabular-nums text-ink" />
      </label>
      <label class="block text-sm text-ink2">
        {t.specDbFloor}
        <input type="number" data-viz-db-floor value="-90" min="-140" max="0" step="1" class="mt-1.5 h-10 w-full rounded-lg border border-line-strong bg-bg px-2.5 font-mono text-sm tabular-nums text-ink" />
      </label>
      <label class="block text-sm text-ink2">
        {t.specDbCeil}
        <input type="number" data-viz-db-ceil value="-20" min="-80" max="0" step="1" class="mt-1.5 h-10 w-full rounded-lg border border-line-strong bg-bg px-2.5 font-mono text-sm tabular-nums text-ink" />
      </label>
      <label class="block text-sm text-ink2">
        {t.specColors}
        <select data-viz-colormap class="mt-1.5 h-10 w-full rounded-lg border border-line-strong bg-bg px-2.5 text-sm text-ink">
          <option value="viridis" selected>{t.specViridis}</option>
          <option value="inferno">{t.specInferno}</option>
          <option value="gray">{t.specGray}</option>
        </select>
      </label>
    </div>

    <div class="grid gap-x-6 gap-y-4 border-b border-line px-4 py-3.5 sm:grid-cols-2 md:px-5 lg:grid-cols-3">
      <label class="block text-sm text-ink2">
        {t.vizSize}
        <select data-viz-size class="mt-1.5 h-10 w-full rounded-lg border border-line-strong bg-bg px-2.5 text-sm text-ink">
          <option value="video" data-w="1920" data-h="1080">{t.vizSizeVideo} · 1920×1080</option>
          <option value="square" data-w="1080" data-h="1080">{t.vizSizeSquare} · 1080×1080</option>
          <option value="og" data-w="1200" data-h="630" selected>{t.vizSizeOg} · 1200×630</option>
          <option value="banner" data-w="800" data-h="200">{t.vizSizeBanner} · 800×200</option>
          <option value="custom">{t.vizSizeCustom}</option>
        </select>
      </label>
      <div data-viz-custom-row class="hidden items-end gap-3 text-sm text-ink2">
        <label class="block">
          {t.vizWidth}
          <input type="number" data-viz-w value="1600" min="100" max="8000" step="10" class="mt-1.5 h-10 w-24 rounded-lg border border-line-strong bg-bg px-2.5 font-mono text-sm tabular-nums text-ink" />
        </label>
        <label class="block">
          {t.vizHeight}
          <input type="number" data-viz-h value="400" min="100" max="8000" step="10" class="mt-1.5 h-10 w-24 rounded-lg border border-line-strong bg-bg px-2.5 font-mono text-sm tabular-nums text-ink" />
        </label>
      </div>
    </div>

    <div class="grid gap-3 border-b border-line px-4 py-3.5 md:px-5">
      <p class="text-sm text-ink2">
        {t.vizRange}
        <span data-viz-range-readout class="ms-2 font-mono text-xs text-ink3"></span>
      </p>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="block text-sm text-ink2">
            {t.vizRangeStart}
            <input type="number" data-viz-start value="0" min="0" step="0.01" class="mt-1.5 h-10 w-full rounded-lg border border-line-strong bg-bg px-2.5 font-mono text-sm tabular-nums text-ink" />
          </label>
          <input type="range" data-viz-start-slider min="0" max="1" step="0.01" value="0" class="mt-2 w-full accent-(--color-accent)" aria-label={t.vizRangeStart} />
        </div>
        <div>
          <label class="block text-sm text-ink2">
            {t.vizRangeEnd}
            <input type="number" data-viz-end value="0" min="0" step="0.01" class="mt-1.5 h-10 w-full rounded-lg border border-line-strong bg-bg px-2.5 font-mono text-sm tabular-nums text-ink" />
          </label>
          <input type="range" data-viz-end-slider min="0" max="1" step="0.01" value="0" class="mt-2 w-full accent-(--color-accent)" aria-label={t.vizRangeEnd} />
        </div>
      </div>
    </div>

    <!-- Export bar -->
    <div class="export-bar flex-wrap">
      <p class="text-xs text-ink3">{t.dropLocal}</p>
      <button type="button" class="btn btn-primary btn-lg ms-auto" data-export disabled>
        <Icon name="download-simple" size={18} />
        <span data-export-label>{config.exportLabel ?? t.export}</span>
      </button>
    </div>
  </div>

  <p data-status class="sr-only" role="status" aria-live="polite"></p>

  <div data-toast-root class="toast-root"></div>
</div>

<script>
  import { initVisualizers } from '../../editor/visualizer-ui';
  initVisualizers();
</script>
