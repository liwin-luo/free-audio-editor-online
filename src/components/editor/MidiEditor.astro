---
/**
 * Audio-to-MIDI island. The model loads on the first convert, not with the page.
 */
import Icon from '../Icon.astro';
import LocalBadge from './LocalBadge.astro';
import DropPromise from './DropPromise.astro';
import { getShell } from '../../i18n';
import type { Locale } from '../../i18n/locales';
import type { EditorConfig } from '../../data/tools';

interface Props {
  config: EditorConfig;
  locale?: Locale;
}
const { config, locale = 'en' } = Astro.props;
const { editor: t } = getShell(locale);
---

<div
  data-midi
  data-i18n={JSON.stringify(t)}
  class="overflow-clip rounded-(--radius-tool) border border-line bg-surface"
>
  <div data-empty>
    <DropPromise config={config} locale={locale}>
      <div data-open tabindex="0" role="button" aria-label={config.dropHint}>
        <span class="mx-auto grid size-10 place-items-center rounded-xl bg-accent-soft text-accent">
          <Icon name="note" size={20} />
        </span>
        <p class="mt-3 text-base font-semibold">{config.dropHint}</p>
      </div>
    </DropPromise>
    <LocalBadge text={t.dropLocal} />
  </div>
  <input type="file" class="hidden" accept={config.accept ?? 'audio/*,video/mp4,.m4a,.opus'} data-file-input />

  <div data-workspace class="hidden">
    <div class="flex items-center justify-between gap-3 border-b border-line px-4 py-2.5 md:px-5">
      <div class="min-w-0">
        <p data-file-name class="truncate text-sm font-medium"></p>
        <p data-file-meta class="font-mono text-xs text-ink3"></p>
      </div>
      <button type="button" class="btn btn-secondary h-9 shrink-0 px-3 text-sm" data-reset>
        {t.changeFile}
      </button>
    </div>

    <p class="px-4 pt-4 text-sm text-ink2 md:px-5">{t.midiCaveat}</p>
    <p data-too-long class="hidden px-4 pt-2 text-sm text-ink2 md:px-5">{t.midiTooLong}</p>

    <div data-progress-row class="hidden px-4 pt-4 md:px-5">
      <div class="h-1.5 w-full overflow-hidden rounded-full bg-surface2">
        <div data-progress-bar class="h-full w-full origin-inline-start rounded-full bg-accent" style="transform: scaleX(0)"></div>
      </div>
    </div>

    <div data-result class="hidden px-4 pt-4 md:px-5">
      <p data-note-count class="font-mono text-2xl font-semibold tabular-nums tracking-tight" aria-live="polite"></p>
      <p data-note-more class="mt-1 hidden text-xs text-ink3"></p>
      <ol data-note-list class="mt-3 max-h-48 list-decimal overflow-auto ps-5 font-mono text-xs leading-5 text-ink2"></ol>
    </div>
    <p data-none class="hidden px-4 pt-4 text-sm text-ink2 md:px-5">{t.midiNone}</p>
    <p class="px-4 pt-3 text-xs text-ink3 md:px-5">{t.midiFirstRun}</p>

    <div class="export-bar flex-wrap">
      <p class="text-xs text-ink3">{t.dropLocal}</p>
      <div class="ms-auto flex flex-wrap items-center gap-2">
        <button type="button" class="btn btn-ghost" data-download disabled>{t.midiDownload}</button>
        <button type="button" class="btn btn-primary btn-lg" data-run>
          <Icon name="note" size={18} />
          <span>{config.exportLabel ?? t.export}</span>
        </button>
      </div>
    </div>
  </div>

  <p data-status class="sr-only" role="status" aria-live="polite"></p>
  <div data-toast-root class="toast-root"></div>
</div>

<script>
  import { initMidi } from '../../editor/midi-ui';
  initMidi();
</script>
