---
/**
 * Island for hiding a picture or a line of text in a WAV spectrogram.
 */
import Icon from '../Icon.astro';
import DropPromise from './DropPromise.astro';
import { getShell } from '../../i18n';
import type { Locale } from '../../i18n/locales';
import type { EditorConfig } from '../../data/tools';

interface Props {
  config: EditorConfig;
  locale?: Locale;
}
const { config, locale = 'en' } = Astro.props;
const { editor: t } = getShell(locale);
---

<div
  data-spec-paint
  data-i18n={JSON.stringify(t)}
  class="overflow-clip rounded-(--radius-tool) border border-line bg-surface"
>
  <div class="grid gap-4 px-4 py-4 md:px-5">
    <label class="block text-sm text-ink2">
      {t.paintText}
      <textarea
        data-paint-text
        rows="2"
        maxlength="32"
        placeholder={t.paintPlaceholder}
        class="mt-1.5 w-full resize-none rounded-lg border border-line-strong bg-bg px-3 py-2 text-base text-ink"
      ></textarea>
    </label>
    <div
      data-paint-drop
      class="cursor-pointer rounded-2xl border-2 border-dashed border-line-strong px-4 py-6 text-center"
      tabindex="0"
      role="button"
      aria-label={config.dropHint}
    >
      <span class="mx-auto grid size-10 place-items-center rounded-xl bg-accent-soft text-accent">
        <Icon name="image" size={18} />
      </span>
      <p class="mt-3 text-sm font-semibold">{config.dropHint}</p>
      <DropPromise config={config} locale={locale} plain />
      <p class="mt-3 text-xs text-ink3">{t.paintImage}</p>
      <input type="file" class="hidden" accept="image/png,image/jpeg,image/webp,image/gif" data-paint-file />
    </div>
    <canvas data-paint-preview class="hidden max-h-40 w-full rounded-lg bg-black" aria-label={t.paintPreview}></canvas>
  </div>
  <div class="export-bar flex-wrap">
    <p class="text-xs text-ink3">{t.dropLocal}</p>
    <button type="button" class="btn btn-primary btn-lg ms-auto" data-export disabled>
      <Icon name="download-simple" size={18} />
      <span data-export-label>{config.exportLabel ?? t.export}</span>
    </button>
  </div>
  <p data-status class="sr-only" role="status" aria-live="polite"></p>
  <div data-toast-root class="toast-root"></div>
</div>

<script>
  import { initSpecPaint } from '../../editor/spectrogram-paint-ui';
  initSpecPaint();
</script>
