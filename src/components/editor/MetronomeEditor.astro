---
/**
 * Metronome island. Oscillator clicks, no file. Export is 4, 8, or 16 bars.
 */
import Icon from '../Icon.astro';
import { EXPORT_FORMATS } from '../../editor/encoders';
import { getShell } from '../../i18n';
import type { Locale } from '../../i18n/locales';
import type { EditorConfig } from '../../data/tools';

interface Props {
  config: EditorConfig;
  locale?: Locale;
}
const { config, locale = 'en' } = Astro.props;
const { editor: t, ui } = getShell(locale);
const allowed = config.formats ?? EXPORT_FORMATS.filter((f) => f.kind !== 'm4r').map((f) => f.id);
const formats = allowed
  .map((id) => EXPORT_FORMATS.find((f) => f.id === id))
  .filter((f) => f !== undefined);
const meters = ['2/4', '3/4', '4/4', '6/8'];
const bars = [4, 8, 16];
---

<div
  data-metronome
  data-i18n={JSON.stringify(t)}
  class="overflow-clip rounded-(--radius-tool) border border-line bg-surface"
>
  <div class="grid gap-5 px-4 py-6 md:px-5">
    <label class="flex items-center gap-3 text-sm text-ink2">
      {t.metroBpm}
      <input type="range" data-metro-bpm min="40" max="240" step="1" value="100" class="h-10 min-w-0 flex-1 accent-(--color-accent)" />
      <span class="w-10 font-mono text-sm tabular-nums text-ink" data-metro-bpm-label>100</span>
      <span class="w-14 font-mono text-xs tabular-nums text-ink3" data-metro-gap>0.60 s</span>
    </label>
    <div class="flex flex-wrap items-center gap-3">
      <label class="flex items-center gap-2 text-sm text-ink2">
        {t.metroMeter}
        <select data-metro-meter class="h-10 rounded-lg border border-line-strong bg-bg px-2.5 text-sm text-ink">
          {meters.map((m) => (
            <option value={m} selected={m === '4/4'}>{m}</option>
          ))}
        </select>
      </label>
      <button type="button" class="btn btn-primary btn-lg" data-metro-play aria-pressed="false">
        {t.metroPlay}
      </button>
    </div>
  </div>

  <div class="export-bar flex-wrap">
    <label class="flex items-center gap-2 text-sm text-ink2">
      {t.metroBars}
      <select data-metro-bars class="h-10 rounded-lg border border-line-strong bg-bg px-2.5 text-sm text-ink">
        {bars.map((n) => (
          <option value={n} selected={n === 4}>{n}</option>
        ))}
      </select>
    </label>
    <label class="flex items-center gap-2 text-sm text-ink2">
      {t.format}
      <select data-format class="h-10 rounded-lg border border-line-strong bg-bg px-2.5 text-sm text-ink">
        {formats.map((f) => (
          <option value={f.id} selected={f.id === (config.defaultFormat ?? 'wav')}>
            {ui.formats[f.id as keyof typeof ui.formats] ?? f.label}
          </option>
        ))}
      </select>
    </label>
    <button type="button" class="btn btn-primary btn-lg ms-auto" data-export>
      <Icon name="download-simple" size={18} />
      {config.exportLabel ?? t.export}
    </button>
  </div>
</div>

<div data-toast-root class="toast-root"></div>

<script>
  import { initMetronome } from '../../editor/metronome-ui';

  initMetronome();
</script>
