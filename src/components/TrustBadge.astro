---
import Icon from './Icon.astro';
import { getShell } from '../i18n';
import { localePath, type Locale } from '../i18n/locales';

interface Props {
  locale?: Locale;
  /** False when the tool still needs a download after the page opens (transcription model). */
  offline?: boolean;
}
const { locale = 'en', offline = true } = Astro.props;
const { ui } = getShell(locale);
---

<div
  class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 rounded-xl border border-line bg-surface px-6 py-3.5 text-sm text-ink2"
>
  <span class="inline-flex items-center gap-2">
    <Icon name="check" size={18} class="text-accent" />
    {ui.trustFree}
  </span>
  <span class="hidden h-4 w-px bg-line sm:block" aria-hidden="true"></span>
  <span class="inline-flex items-center gap-2">
    <Icon name="clock-counter-clockwise" size={18} class="text-accent" />
    {ui.trustClean}
  </span>
  {
    offline && (
      <>
        <span class="hidden h-4 w-px bg-line sm:block" aria-hidden="true" />
        <span class="inline-flex items-center gap-2">
          <Icon name="wifi-slash" size={18} class="text-accent" />
          {ui.trustOffline}
        </span>
      </>
    )
  }
  <span class="hidden h-4 w-px bg-line sm:block" aria-hidden="true"></span>
  <a
    href={locale === 'en' ? '/editorial' : localePath(locale, '/about')}
    class="inline-flex items-center gap-1 font-medium text-accent hover:underline pointer-coarse:min-h-6"
  >
    {ui.trustMethod}
    <span aria-hidden="true">→</span>
  </a>
</div>
