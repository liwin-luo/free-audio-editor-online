---
import Icon from './Icon.astro';
import { CATEGORY_IDS, TOOLS } from '../data/tools';
import { getShell, localizeTool } from '../i18n';
import { localePath, type Locale } from '../i18n/locales';

interface Props {
  locale?: Locale;
  /** Canonical URL of the current page. */
  shareUrl: string;
  /** Page title sent as the share text. */
  shareTitle: string;
}
const { locale = 'en', shareUrl, shareTitle } = Astro.props;
const { ui } = getShell(locale);
const year = new Date().getFullYear();
const toolName = (slug: string) => localizeTool(slug, locale)?.name ?? slug;
const q = encodeURIComponent;
const shares = [
  { name: 'X', href: `https://x.com/intent/post?url=${q(shareUrl)}&text=${q(shareTitle)}` },
  { name: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${q(shareUrl)}` },
  { name: 'Reddit', href: `https://www.reddit.com/submit?url=${q(shareUrl)}&title=${q(shareTitle)}` },
  { name: 'WhatsApp', href: `https://wa.me/?text=${q(`${shareTitle} ${shareUrl}`)}` },
];
const shareOn = (name: string) => ui.shareOn.replace('{name}', name);
---

<footer class="mt-20 border-t border-line bg-surface">
  <div class="container-wide grid gap-6 py-10 sm:grid-cols-2 sm:gap-10 sm:py-12 lg:grid-cols-4">
    <div>
      <a href={localePath(locale, '/')} class="flex items-center gap-2.5 font-semibold tracking-tight">
        <span class="grid size-8 place-items-center rounded-lg bg-accent text-on-accent">
          <Icon name="waveform" size={18} />
        </span>
        Free Audio Editor
      </a>
      <p class="mt-3 max-w-[38ch] text-sm leading-relaxed text-ink2">
        {ui.footerBlurb}
      </p>
      <div class="mt-5">
        <p class="text-[11px] font-medium uppercase tracking-wider text-ink3">{ui.share}</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {
            shares.map((item) => (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={shareOn(item.name)}
                class="inline-flex h-8 items-center rounded-full border border-line px-3 text-xs text-ink2 hover:border-ink3 hover:text-ink pointer-coarse:h-11"
              >
                {item.name}
              </a>
            ))
          }
          <button
            type="button"
            data-copy-link
            data-url={shareUrl}
            data-copied={ui.copied}
            class="inline-flex h-8 items-center rounded-full border border-line px-3 text-xs text-ink2 hover:border-ink3 hover:text-ink pointer-coarse:h-11"
          >
            <span data-copy-label aria-live="polite">{ui.copyLink}</span>
          </button>
        </div>
      </div>
    </div>

    {
      CATEGORY_IDS.map((cat) => (
        <nav aria-label={ui.categories[cat]}>
          <details class="group" data-footer-group open>
            <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 md:min-h-0">
              <a
                href={localePath(locale, `/tools/${cat}`)}
                class="text-[11px] font-medium uppercase tracking-wider text-ink3 hover:text-accent pointer-coarse:inline-flex pointer-coarse:min-h-6 pointer-coarse:items-center"
              >
                {ui.categories[cat]}
              </a>
              <Icon
                name="caret-down"
                size={16}
                class="shrink-0 text-ink3 transition-transform group-open:rotate-180"
              />
            </summary>
            <ul class="mt-3 space-y-2 text-sm">
              {TOOLS.filter((t) => t.category === cat).map((t) => (
                <li>
                  <a href={localePath(locale, `/${t.slug}`)} class="text-ink2 hover:text-accent">
                    {toolName(t.slug)}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </nav>
      ))
    }

    <nav aria-label={ui.navAbout}>
      <p class="text-[11px] font-medium uppercase tracking-wider text-ink3">{ui.about}</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href={localePath(locale, '/tools')} class="text-ink2 hover:text-accent">{ui.allTools}</a></li>
        <li><a href={localePath(locale, '/guides')} class="text-ink2 hover:text-accent">{ui.guides}</a></li>
        <li><a href={localePath(locale, '/about')} class="text-ink2 hover:text-accent">{ui.about}</a></li>
        <li><a href="/mcp" class="text-ink2 hover:text-accent">Audio MCP</a></li>
        <li><a href={localePath(locale, '/contact')} class="text-ink2 hover:text-accent">{ui.contact}</a></li>
        <li><a href={localePath(locale, '/privacy')} class="text-ink2 hover:text-accent">{ui.privacy}</a></li>
        <li><a href="/llms.txt" class="text-ink2 hover:text-accent">llms.txt</a></li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-line">
    <div class="container-wide flex flex-wrap items-center justify-between gap-2 py-4 text-xs text-ink3">
      <p>© {year} Free Audio Editor. {ui.rights}</p>
      <div class="flex flex-wrap items-center gap-4">
        <p class="inline-flex items-center gap-1.5">
          <Icon name="shield-check" size={14} />
          {ui.clientSide}
        </p>
        <a
          href="https://stats.uptimerobot.com/jeUgIH7UTe"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 hover:text-ink pointer-coarse:min-h-6"
        >
          {ui.status}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</footer>
<script is:inline>
  // The tool index runs to ~30 links, so on phones each category starts folded.
  // Native <details> keeps the toggle working even when this script never runs.
  const footerGroups = document.querySelectorAll('[data-footer-group]');
  const narrowScreen = window.matchMedia('(max-width: 767px)');
  const syncFooterGroups = () => {
    for (const group of footerGroups) group.open = !narrowScreen.matches;
  };
  syncFooterGroups();
  narrowScreen.addEventListener('change', syncFooterGroups);
</script>
<script>
  for (const btn of document.querySelectorAll('[data-copy-link]')) {
    if (!(btn instanceof HTMLButtonElement) || btn.dataset.bound) continue;
    btn.dataset.bound = '1';
    btn.addEventListener('click', async () => {
      const url = btn.dataset.url ?? '';
      const label = btn.querySelector('[data-copy-label]');
      let ok = false;
      try {
        await navigator.clipboard.writeText(url);
        ok = true;
      } catch {
        try {
          const input = document.createElement('textarea');
          input.value = url;
          input.setAttribute('readonly', '');
          input.style.position = 'fixed';
          input.style.opacity = '0';
          document.body.append(input);
          input.select();
          ok = document.execCommand('copy');
          input.remove();
        } catch {
          ok = false;
        }
      }
      if (!ok || !label) return;
      const previous = label.textContent;
      label.textContent = btn.dataset.copied ?? previous;
      window.setTimeout(() => {
        label.textContent = previous;
      }, 2000);
    });
  }
</script>
