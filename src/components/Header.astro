---
import Icon from './Icon.astro';
import { CATEGORY_IDS, TOOLS } from '../data/tools';
import { guideAlternates } from '../data/guides';
import { getShell, localizeTool } from '../i18n';
import { LOCALES, localePath, type Locale } from '../i18n/locales';

interface Props {
  locale?: Locale;
  path?: string;
}
const { locale = 'en', path = '/' } = Astro.props;
const { ui } = getShell(locale);
const guidesHref = localePath(locale, '/guides');
const onGuide = path === '/guides' || path.startsWith('/guides/') || path === '/guias' || path.startsWith('/guias/');
// a locale without this guide (per-market guides; locales without the
// translated article) falls back to its guides index instead of a 404
const langHref = (target: Locale) => {
  if (path === '/404') return localePath(target, '/');
  if (!onGuide) return localePath(target, path);
  return guideAlternates(path).find((a) => a.locale === target)?.href ?? localePath(target, '/guides');
};
const current = LOCALES.find((l) => l.id === locale)!;
const toolName = (slug: string) => localizeTool(slug, locale)?.name ?? slug;
---

<header class="sticky top-0 z-10 border-b border-line bg-bg/90 backdrop-blur">
  <div class="container-wide flex h-16 items-center justify-between gap-4">
    <a href={localePath(locale, '/')} class="flex items-center gap-2.5 font-semibold tracking-tight" aria-label={ui.logoHome}>
      <span class="grid size-8 place-items-center rounded-lg bg-accent text-white">
        <Icon name="waveform" size={18} />
      </span>
      <span class="hidden sm:block">Free Audio Editor</span>
    </a>

    <nav class="flex items-center gap-1" aria-label={ui.navMain}>
      {
        <a href={guidesHref} class="btn btn-ghost" aria-current={path === '/guides' ? 'page' : undefined}>
          {ui.guides}
        </a>
      }
      <details class="group relative" data-nav-dropdown>
        <summary
          class="btn btn-ghost list-none aria-expanded:bg-surface2"
          aria-haspopup="true"
        >
          {ui.tools}
          <Icon name="caret-down" size={16} class="transition-transform group-open:rotate-180" />
        </summary>
        <div
          class="fixed inset-x-3 top-[4.25rem] z-30 max-h-[calc(100dvh-5rem)] overflow-y-auto overscroll-contain rounded-xl border border-line bg-surface p-2 shadow-[0_8px_24px_-8px_rgba(9,9,11,0.15)] sm:absolute sm:inset-x-auto sm:end-0 sm:top-full sm:mt-2 sm:w-[32rem] lg:w-[40rem]"
        >
          {
            CATEGORY_IDS.map((cat) => (
              <div class="mb-1 last:mb-0">
                <p class="px-3 pt-2 pb-1 text-[11px] font-medium uppercase tracking-wider text-ink3">{ui.categories[cat]}</p>
                <div class="grid grid-cols-2 gap-x-1 lg:grid-cols-3 lg:gap-x-2">
                  {TOOLS.filter((t) => t.category === cat).map((t) => (
                    <a
                      href={localePath(locale, `/${t.slug}`)}
                      class="flex items-center gap-2.5 rounded-lg px-3 py-1.5 text-sm leading-snug text-ink2 hover:bg-surface2 hover:text-ink"
                    >
                      <Icon name={t.icon} size={18} class="shrink-0 text-ink3" />
                      <span class="min-w-0">{toolName(t.slug)}</span>
                    </a>
                  ))}
                </div>
              </div>
            ))
          }
          <a
            href={localePath(locale, '/tools')}
            class="mt-1 flex items-center gap-2.5 rounded-lg border-t border-line px-3 py-2 text-sm font-medium text-ink2 hover:bg-surface2 hover:text-ink"
          >
            <Icon name="layers" size={18} class="shrink-0 text-ink3" />
            {ui.allTools}
          </a>
        </div>
      </details>

      <details class="group relative" data-nav-dropdown>
            <summary class="btn btn-ghost list-none gap-1.5 px-2.5 text-sm font-normal text-ink2 aria-expanded:bg-surface2" aria-label={ui.language}>
              <Icon name="globe" size={18} />
              <span class="hidden sm:inline">{current.label}</span>
              <Icon name="caret-down" size={14} class="transition-transform group-open:rotate-180" />
            </summary>
            <div class="absolute end-0 top-full z-30 mt-2 w-44 rounded-xl border border-line bg-surface p-1.5 shadow-[0_8px_24px_-8px_rgba(9,9,11,0.15)]">
              {LOCALES.map((l) => (
                <a
                  href={langHref(l.id)}
                  hreflang={l.hreflang}
                  class:list={[
                    'block rounded-lg px-3 py-2 text-sm hover:bg-surface2',
                    l.id === locale ? 'font-medium text-ink' : 'text-ink2',
                  ]}
                  aria-current={l.id === locale ? 'true' : undefined}
                >
                  {l.label}
                </a>
              ))}
            </div>
          </details>

      <button
        type="button"
        class="btn btn-ghost size-10 p-0"
        data-theme-toggle
        aria-label={ui.theme}
      >
        <span class="hidden dark:block"><Icon name="sun" size={18} /></span>
        <span class="dark:hidden"><Icon name="moon" size={18} /></span>
      </button>
    </nav>
  </div>
</header>

<script is:inline>
  // Close the tools dropdown when clicking outside of it
  document.addEventListener('click', (e) => {
    document.querySelectorAll('[data-nav-dropdown][open]').forEach((d) => {
      if (!d.contains(e.target)) d.removeAttribute('open');
    });
  });

  // Escape closes; opening one dropdown closes the other
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('[data-nav-dropdown][open]').forEach((d) => d.removeAttribute('open'));
    }
  });
  document.querySelectorAll('[data-nav-dropdown]').forEach((d) => {
    d.addEventListener('toggle', () => {
      if (!d.open) return;
      document.querySelectorAll('[data-nav-dropdown][open]').forEach((o) => {
        if (o !== d) o.removeAttribute('open');
      });
    });
  });

  // Theme toggle
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* private mode */
    }
    window.dispatchEvent(new CustomEvent('themechange'));
  });
</script>
