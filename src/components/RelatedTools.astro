---
import Icon from './Icon.astro';
import { TOOLS, type ToolDef } from '../data/tools';

interface Props {
  current: ToolDef;
}
const { current } = Astro.props;
const related = current.related
  .map((slug) => TOOLS.find((t) => t.slug === slug))
  .filter((t): t is ToolDef => Boolean(t));
---

<section class="py-16" aria-labelledby="related-heading">
  <div class="container-page">
    <h2 id="related-heading" class="text-2xl font-semibold tracking-tight md:text-3xl">
      Related tools
    </h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 md:grid-cols-[2fr_1fr_1fr]">
      {
        related.map((tool, i) =>
          i === 0 ? (
            <a
              href={`/${tool.slug}`}
              class="group flex flex-col rounded-xl border border-line bg-surface p-6 transition-colors hover:border-accent sm:col-span-2 md:col-span-1"
            >
              <span class="grid size-12 place-items-center rounded-xl bg-accent-soft text-accent">
                <Icon name={tool.icon} size={24} />
              </span>
              <h3 class="mt-5 text-lg font-medium group-hover:text-accent">{tool.name}</h3>
              <p class="mt-1.5 flex-1 text-sm leading-relaxed text-ink2">{tool.subtitle}</p>
              <p class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-accent">
                Open {tool.name}
                <Icon name="convert" size={15} class="transition-transform group-hover:translate-x-0.5" />
              </p>
            </a>
          ) : (
            <a
              href={`/${tool.slug}`}
              class="group flex flex-col rounded-xl border border-line bg-surface p-5 transition-colors hover:border-accent"
            >
              <span class="grid size-10 place-items-center rounded-lg bg-accent-soft text-accent">
                <Icon name={tool.icon} size={20} />
              </span>
              <h3 class="mt-4 font-medium group-hover:text-accent">{tool.name}</h3>
              <p class="mt-1.5 line-clamp-2 flex-1 text-sm leading-relaxed text-ink2">{tool.subtitle}</p>
            </a>
          )
        )
      }
    </div>
    <a
      href="/"
      class="group mt-4 flex items-center justify-between gap-3 rounded-xl border border-dashed border-line px-5 py-4 text-ink2 transition-colors hover:border-accent hover:text-accent"
    >
      <span class="font-medium">All audio tools</span>
      <span class="inline-flex items-center gap-1.5 text-sm">
        Browse the full toolkit
        <Icon name="convert" size={16} class="transition-transform group-hover:translate-x-0.5" />
      </span>
    </a>
  </div>
</section>
