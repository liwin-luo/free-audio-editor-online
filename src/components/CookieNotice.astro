---
import { getShell } from '../i18n';
import { localePath, type Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { ui } = getShell(locale);
---

<section
  id="cookie-notice"
  hidden
  class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-surface shadow-pop"
  aria-labelledby="cookie-notice-text"
>
  <div
    class="container-wide flex flex-col gap-4 py-4 pb-[max(1rem,env(safe-area-inset-bottom))] sm:flex-row sm:items-center sm:justify-between"
  >
    <p id="cookie-notice-text" class="max-w-3xl text-sm leading-relaxed text-ink2">
      {ui.cookieBody}
      <a href={localePath(locale, '/privacy')} class="mt-1 block w-fit text-accent underline underline-offset-2">
        {ui.cookiePolicy}
      </a>
    </p>
    <div class="flex w-full shrink-0 flex-col gap-2 sm:w-48">
      <button type="button" class="btn btn-primary h-11" data-cookie="accepted">{ui.cookieAccept}</button>
      <button type="button" class="btn h-11 bg-surface2 text-ink" data-cookie="rejected">{ui.cookieReject}</button>
    </div>
  </div>
</section>
<script is:inline>
  try {
    if (!localStorage.getItem('fae-consent')) {
      var notice = document.getElementById('cookie-notice');
      if (notice) notice.hidden = false;
    }
  } catch (e) {}
</script>
