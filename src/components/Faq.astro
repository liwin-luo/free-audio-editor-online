---
import type { FaqItem } from '../data/tools';
import { getShell } from '../i18n';
import type { Locale } from '../i18n/locales';

interface Props {
  faqs: FaqItem[];
  locale?: Locale;
  heading?: string;
}
const { faqs, locale = 'en', heading } = Astro.props;
const { ui } = getShell(locale);

function answerParts(text: string): { link: boolean; value: string }[] {
  return text
    .split(/(\/mcp)(?![A-Za-z0-9_-])/)
    .filter((part) => part.length > 0)
    .map((value) => ({ link: value === '/mcp', value }));
}
---

<section class="py-16" aria-labelledby="faq-heading">
  <div class="container-page">
    <h2 id="faq-heading" class="text-[28px] font-semibold tracking-tight">
      {heading ?? ui.faqHeading}
    </h2>
    <div class="mt-8 space-y-3">
      {
        faqs.map((f) => (
          <details class="card group px-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-medium">
              {f.q}
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                class="shrink-0 text-ink3 transition-transform duration-200 group-open:rotate-180"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <p class="pb-5 text-[15px] leading-relaxed text-ink2">
              {
                answerParts(f.a).map((part) =>
                  part.link ? (
                    <a href="/mcp" class="text-accent hover:underline">
                      {part.value}
                    </a>
                  ) : (
                    part.value
                  ),
                )
              }
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
