---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
// Same file the fontsource CSS references — Vite emits it once, so this URL
// matches the @font-face src and warms it ahead of the CSS parse.
import geistLatinUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieNotice from '../components/CookieNotice.astro';
import { SITE } from '../data/site';
import { getShell } from '../i18n';
import { guideAlternates, hasAlternates, isTranslatedGuide, localesWithGuides } from '../data/guides';
import { LOCALES, localeMeta, localePath, type Locale } from '../i18n/locales';

interface Props {
  /** <title> tag content */
  title: string;
  /** meta description, <= 155 chars */
  description: string;
  /** Unprefixed canonical path starting with "/", e.g. "/audio-trimmer" */
  path: string;
  locale?: Locale;
  /** JSON-LD structured data objects */
  jsonLd?: object[];
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** ISO timestamp for article:published_time (guide pages). */
  publishedTime?: string;
  /** ISO timestamp for article:modified_time (guide pages). */
  modifiedTime?: string;
  /** Visible section label for article:section (guide pages). */
  articleSection?: string;
}

const {
  title,
  description,
  path,
  locale = 'en',
  jsonLd = [],
  ogType = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  articleSection,
} = Astro.props;
const { ui } = getShell(locale);
const meta = localeMeta(locale);
const canonical = new URL(localePath(locale, path), SITE.url).href;
const ogImage =
  {
    '/audio-trimmer': '/og-trim.jpg',
    '/mp3-cutter': '/og-cut.jpg',
    '/mp3-editor': '/og-cut.jpg',
    '/audio-joiner': '/og-join.jpg',
    '/mp4-to-mp3': '/og-mp4.jpg',
    '/extract-audio': '/og-mp4.jpg',
    '/ringtone-maker': '/og-ring.jpg',
    '/wav-to-mp3': '/og-wav.jpg',
    '/m4a-to-mp3': '/og-m4a.jpg',
    '/compress-audio': '/og-compress.jpg',
    '/voice-recorder': '/og-voice.jpg',
    '/normalize-audio': '/og-normalize.jpg',
  }[path] ?? '/og.jpg';
const guideLocales = new Set(localesWithGuides());
// The index alternates across locales that have any guide. A translated
// article alternates only across locales that actually have that article.
// A cluster can use a different slug per language (OGG).
const cluster = isTranslatedGuide(path) ? guideAlternates(path) : [];
const alternateList =
  path === '/editorial' || path === '/mcp'
    ? LOCALES.filter((l) => l.id === 'en')
    : path === '/guides'
      ? LOCALES.filter((l) => guideLocales.has(l.id))
      : cluster.length > 1
        ? LOCALES.filter((l) => cluster.some((a) => a.locale === l.id))
        : LOCALES;
const hrefFor = (id: Locale) => cluster.find((a) => a.locale === id)?.href ?? localePath(id, path);
const alternates = hasAlternates(path) && !noindex && alternateList.length > 1;
---

<!doctype html>
<html lang={meta.html} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      alternates &&
        alternateList.map((l) => (
          <link rel="alternate" hreflang={l.hreflang} href={new URL(hrefFor(l.id), SITE.url).href} />
        ))
    }
    {alternates && <link rel="alternate" hreflang="x-default" href={new URL(hrefFor('en'), SITE.url).href} />}
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'max-image-preview:large'} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#0d9488" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#09090b" />

    <meta property="og:type" content={ogType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {articleSection && <meta property="article:section" content={articleSection} />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={meta.og} />
    {
      alternates &&
        alternateList.filter((l) => l.id !== locale).map((l) => (
          <meta property="og:locale:alternate" content={l.og} />
        ))
    }
    <meta property="og:image" content={new URL(ogImage, SITE.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ui.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, SITE.url).href} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical-llms" href="/llms.txt" />
    <link rel="preload" href={geistLatinUrl} as="font" type="font/woff2" crossorigin />

    <script is:inline>
      // Apply theme before first paint to avoid a flash of the wrong theme
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        var theme =
          stored === 'dark' || stored === 'light'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    {
      jsonLd.map((obj) => (
        // \u003c keeps any literal "</script>" inside translated strings from
        // terminating the script block early.
        <script type="application/ld+json" set:html={JSON.stringify(obj).replace(/</g, '\\u003c')} />
      ))
    }
  </head>
  <body class="min-h-[100dvh] bg-bg font-sans text-ink antialiased">
    <a href="#main" class="skip-link">{ui.skip}</a>
    <Header locale={locale} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} shareUrl={canonical} shareTitle={title} />
    <CookieNotice locale={locale} />
    <script>
      import { installConsent } from '../consent';
      installConsent(document);
    </script>
    <script>
      // Vercel Web Analytics — cookieless, aggregate-only. Only inject on the
      // production host so local previews and staging deploys stay clean.
      if (location.hostname.endsWith('freeaudioeditor.online')) {
        import('@vercel/analytics').then(({ inject }) => inject());
      }
    </script>
    <script>
      import { installDesktopSave } from '../desktop/save';
      installDesktopSave();
    </script>
  </body>
</html>
