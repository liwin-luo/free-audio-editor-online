---
/**
 * Layout for /guides/ articles (Astro markdown pages).
 * Frontmatter: title, description, tool (slug for the CTA card), date.
 */
import '../i18n/catalogs';
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import { getShell, localizeTool } from '../i18n';
import { isLocale, localeMeta, localePath, type Locale } from '../i18n/locales';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    tool?: string;
    date?: string;
    audio?: string;
    youtube?: string;
    poster?: string;
    locale?: string;
  };
  /** Markdown file url, e.g. "/guides/how-to-cut-a-song" */
  file: string;
}

const { frontmatter, file } = Astro.props;
// `file` is a build-machine path on Vercel (e.g. /vercel/path0/src/pages/…);
// reduce it to the page route so canonicals never leak build paths.
const filePath = '/' + (file.replace(/\\/g, '/').split('/src/pages/')[1]?.replace(/\.(md|mdx)$/, '') ?? file.replace(/^\//, ''));
const locale: Locale = isLocale(frontmatter.locale) ? frontmatter.locale : 'en';
const path = locale !== 'en' && filePath.startsWith(`/${locale}/`) ? filePath.slice(locale.length + 1) : filePath;
const guidesPath = '/guides';
const { ui } = getShell(locale);
const tool = frontmatter.tool ? localizeTool(frontmatter.tool, locale) : undefined;
const date = frontmatter.date ?? '2026-10-14';
const pageUrl = new URL(localePath(locale, path), SITE.url).href;
const copy = {
  en: {
    ready: 'Ready to try it?',
    blurb: 'Free, no signup, nothing uploaded.',
    open: 'Open',
    more: 'More hands-on walkthroughs in',
    all: 'all guides',
    series: 'Free Audio Editor Guides',
  },
  es: {
    ready: '¿Listo para probarlo?',
    blurb: 'Gratis, sin cuenta, y el archivo no se sube.',
    open: 'Abrir',
    more: 'Más guías en',
    all: 'todas las guías',
    series: 'Guías de Free Audio Editor',
  },
  pt: {
    ready: 'Pronto para testar?',
    blurb: 'Grátis, sem conta, e o arquivo não é enviado.',
    open: 'Abrir',
    more: 'Mais guias em',
    all: 'todos os guias',
    series: 'Guias do Free Audio Editor',
  },
  id: {
    ready: 'Siap mencoba?',
    blurb: 'Gratis, tanpa akun, dan file tidak diunggah.',
    open: 'Buka',
    more: 'Panduan lain di',
    all: 'semua panduan',
    series: 'Panduan Free Audio Editor',
  },
  de: {
    ready: 'Bereit, es auszuprobieren?',
    blurb: 'Kostenlos, ohne Konto, und die Datei wird nicht hochgeladen.',
    open: 'Öffnen',
    more: 'Weitere Anleitungen unter',
    all: 'allen Anleitungen',
    series: 'Anleitungen von Free Audio Editor',
  },
  ja: {
    ready: '試しますか？',
    blurb: '無料、登録なし。ファイルはアップロードされません。',
    open: '開く',
    more: 'ほかのガイドは',
    all: 'ガイド一覧',
    series: 'Free Audio Editor のガイド',
  },
  ko: {
    ready: '써 볼까요?',
    blurb: '무료, 가입 없음. 파일은 업로드되지 않아요.',
    open: '열기',
    more: '다른 가이드는',
    all: '가이드 목록',
    series: 'Free Audio Editor 가이드',
  },
  zh: {
    ready: '要试一下吗？',
    blurb: '免费，不用注册，文件不会上传。',
    open: '打开',
    more: '更多说明在',
    all: '全部指南',
    series: 'Free Audio Editor 指南',
  },
  fr: {
    ready: 'Prêt à l’essayer ?',
    blurb: 'Gratuit, sans compte, et le fichier n’est pas envoyé.',
    open: 'Ouvrir',
    more: 'D’autres guides dans',
    all: 'tous les guides',
    series: 'Guides de Free Audio Editor',
  },
  ru: {
    ready: 'Готовы попробовать?',
    blurb: 'Бесплатно, без регистрации, файл не загружается.',
    open: 'Открыть',
    more: 'Другие руководства в разделе',
    all: 'все руководства',
    series: 'Руководства Free Audio Editor',
  },
  ar: {
    ready: 'مستعد لتجربته؟',
    blurb: 'مجاني، بلا حساب، والملف لا يُرفع.',
    open: 'فتح',
    more: 'مزيد من الشروح في',
    all: 'كل الشروح',
    series: 'شروح Free Audio Editor',
  },
}[locale];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: frontmatter.title,
    description: frontmatter.description,
    datePublished: date,
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    mainEntityOfPage: pageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ui.home, item: new URL(localePath(locale, '/'), SITE.url).href },
      { '@type': 'ListItem', position: 2, name: ui.guides, item: new URL(localePath(locale, guidesPath), SITE.url).href },
      { '@type': 'ListItem', position: 3, name: frontmatter.title, item: pageUrl },
    ],
  },
  ...(frontmatter.youtube
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'VideoObject',
          name: frontmatter.title,
          description: frontmatter.description,
          thumbnailUrl: [
            `https://i.ytimg.com/vi/${frontmatter.youtube}/maxresdefault.jpg`,
            `https://i.ytimg.com/vi/${frontmatter.youtube}/hqdefault.jpg`,
          ],
          uploadDate: `${date}T00:00:00Z`,
          embedUrl: `https://www.youtube-nocookie.com/embed/${frontmatter.youtube}`,
          contentUrl: `https://youtu.be/${frontmatter.youtube}`,
        },
      ]
    : []),
];
---

<Base title={frontmatter.title} description={frontmatter.description} path={path} locale={locale} jsonLd={jsonLd} ogType="article">
  <div class="container-page">
    <nav aria-label="Breadcrumb" class="pt-5 text-xs">
      <a href={localePath(locale, '/')} class="text-ink3 hover:text-accent">{ui.home}</a>
      <span class="mx-1.5 text-ink3">/</span>
      <a href={localePath(locale, guidesPath)} class="text-ink3 hover:text-accent">{ui.guides}</a>
      <span class="mx-1.5 text-ink3">/</span>
      <span class="text-ink2" aria-current="page">{frontmatter.title}</span>
    </nav>

    <article class="py-8">
      <header class="max-w-[70ch]">
        <h1 class="text-3xl font-semibold leading-tight tracking-tight md:text-4xl">{frontmatter.title}</h1>
        <p class="mt-3 text-sm text-ink3">
          <time datetime={date}>{new Date(date).toLocaleDateString(localeMeta(locale).html, { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          · {copy.series}
        </p>
        {
          frontmatter.audio && (
            <div class="mt-5 flex items-center gap-3 rounded-xl border border-line bg-surface px-4 py-3">
              <span class="text-sm font-medium text-ink2">Listen</span>
              <audio controls preload="none" src={frontmatter.audio} class="h-10 w-full max-w-md" />
              {frontmatter.youtube ? (
                <a
                  href={`https://youtu.be/${frontmatter.youtube}`}
                  target="_blank"
                  rel="noopener"
                  class="hidden text-xs text-accent underline underline-offset-2 sm:block"
                >
                  or watch on YouTube
                </a>
              ) : (
                <span class="hidden text-xs text-ink3 sm:block">or watch the video version on YouTube</span>
              )}
            </div>
          )
        }
      </header>

      {
        frontmatter.youtube && (
          <div class="mt-8 max-w-[70ch]">
            <div class="relative aspect-video overflow-hidden rounded-xl border border-line bg-surface2">
              <button
                type="button"
                class="group absolute inset-0 h-full w-full cursor-pointer"
                data-yt-play={frontmatter.youtube}
                aria-label={`Play video: ${frontmatter.title}`}
              >
                <img
                  src={frontmatter.poster ?? `https://i.ytimg.com/vi/${frontmatter.youtube}/hqdefault.jpg`}
                  alt={`Video walkthrough: ${frontmatter.title}`}
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
                <span class="absolute inset-0 grid place-items-center">
                  <span class="grid size-16 place-items-center rounded-full bg-accent text-white shadow-[0_10px_30px_-8px_rgba(13,148,136,0.6)] transition-transform duration-200 group-hover:scale-105 group-active:scale-95">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M8 5.5v13l10-6.5-10-6.5Z" />
                    </svg>
                  </span>
                </span>
              </button>
            </div>
            <p class="mt-2 text-xs text-ink3">
              Prefer watching?{' '}
              <a href={`https://youtu.be/${frontmatter.youtube}`} target="_blank" rel="noopener" class="text-accent underline underline-offset-2">
                Watch on YouTube
              </a>{' '}
              and follow the channel for new guides.
            </p>
          </div>
        )
      }

      <div class="guide-prose mt-8 max-w-[70ch]">
        <slot />
      </div>

      {
        tool && (
          <aside class="mt-12 flex max-w-[70ch] flex-col items-start gap-4 rounded-xl border border-line bg-surface p-6 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="font-medium">{copy.ready}</p>
              <p class="mt-1 text-sm text-ink2">
                {tool.name}{locale === 'zh' || locale === 'ja' ? '。' : '. '}{copy.blurb}
              </p>
            </div>
            <a href={localePath(locale, `/${tool.slug}`)} class="btn btn-primary shrink-0">
              {copy.open} {tool.shortName}
              <Icon name="convert" size={16} />
            </a>
          </aside>
        )
      }

      <p class="mt-10 max-w-[70ch] text-sm text-ink3">
        {copy.more}
        <a href={localePath(locale, guidesPath)} class="text-accent underline underline-offset-2 hover:underline">{copy.all}</a>{locale === 'zh' || locale === 'ja' ? '。' : '.'}
      </p>
    </article>
  </div>

  <script is:inline>
    // YouTube facade: swap in the iframe only when the visitor clicks, so the
    // page never loads third-party embed JavaScript by default
    document.querySelectorAll('[data-yt-play]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-yt-play');
        if (!id) return;
        const frame = document.createElement('iframe');
        frame.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
        frame.title = 'Video guide';
        frame.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
        frame.allowFullscreen = true;
        frame.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0';
        btn.replaceWith(frame);
      });
    });
  </script>
</Base>
