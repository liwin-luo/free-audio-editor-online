---
/**
 * Layout for /guides/ articles (Astro markdown pages).
 * Frontmatter: title, description, tool (slug for the CTA card), date.
 */
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import { getTool } from '../data/tools';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    tool?: string;
    date?: string;
    audio?: string;
    youtube?: string;
    poster?: string;
  };
  /** Markdown file url, e.g. "/guides/how-to-cut-a-song" */
  file: string;
}

const { frontmatter, file } = Astro.props;
const path = file.replace(/\.(md|mdx)$/, '');
const tool = frontmatter.tool ? getTool(frontmatter.tool) : undefined;
const date = frontmatter.date ?? '2026-10-14';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: frontmatter.title,
    description: frontmatter.description,
    datePublished: date,
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    mainEntityOfPage: new URL(path, SITE.url).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides', SITE.url).href },
      { '@type': 'ListItem', position: 3, name: frontmatter.title, item: new URL(path, SITE.url).href },
    ],
  },
  ...(frontmatter.youtube
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'VideoObject',
          name: frontmatter.title,
          description: frontmatter.description,
          thumbnailUrl: [
            `https://i.ytimg.com/vi/${frontmatter.youtube}/maxresdefault.jpg`,
            `https://i.ytimg.com/vi/${frontmatter.youtube}/hqdefault.jpg`,
          ],
          uploadDate: `${date}T00:00:00Z`,
          embedUrl: `https://www.youtube-nocookie.com/embed/${frontmatter.youtube}`,
          contentUrl: `https://youtu.be/${frontmatter.youtube}`,
        },
      ]
    : []),
];
---

<Base title={`${frontmatter.title} — Free Audio Editor`} description={frontmatter.description} path={path} jsonLd={jsonLd} ogType="article">
  <div class="container-page">
    <nav aria-label="Breadcrumb" class="pt-5 text-xs">
      <a href="/" class="text-ink3 hover:text-accent">Home</a>
      <span class="mx-1.5 text-ink3">/</span>
      <a href="/guides" class="text-ink3 hover:text-accent">Guides</a>
      <span class="mx-1.5 text-ink3">/</span>
      <span class="text-ink2" aria-current="page">{frontmatter.title}</span>
    </nav>

    <article class="py-8">
      <header class="max-w-[70ch]">
        <h1 class="text-3xl font-semibold leading-tight tracking-tight md:text-4xl">{frontmatter.title}</h1>
        <p class="mt-3 text-sm text-ink3">
          <time datetime={date}>{new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          · Free Audio Editor Guides
        </p>
        {
          frontmatter.audio && (
            <div class="mt-5 flex items-center gap-3 rounded-xl border border-line bg-surface px-4 py-3">
              <span class="text-sm font-medium text-ink2">Listen</span>
              <audio controls preload="none" src={frontmatter.audio} class="h-10 w-full max-w-md" />
              {frontmatter.youtube ? (
                <a
                  href={`https://youtu.be/${frontmatter.youtube}`}
                  target="_blank"
                  rel="noopener"
                  class="hidden text-xs text-accent underline underline-offset-2 sm:block"
                >
                  or watch on YouTube
                </a>
              ) : (
                <span class="hidden text-xs text-ink3 sm:block">or watch the video version on YouTube</span>
              )}
            </div>
          )
        }
      </header>

      {
        frontmatter.youtube && (
          <div class="mt-8 max-w-[70ch]">
            <div class="relative aspect-video overflow-hidden rounded-xl border border-line bg-surface2">
              <button
                type="button"
                class="group absolute inset-0 h-full w-full cursor-pointer"
                data-yt-play={frontmatter.youtube}
                aria-label={`Play video: ${frontmatter.title}`}
              >
                <img
                  src={frontmatter.poster ?? `https://i.ytimg.com/vi/${frontmatter.youtube}/hqdefault.jpg`}
                  alt={`Video walkthrough: ${frontmatter.title}`}
                  loading="lazy"
                  class="h-full w-full object-cover"
                />
                <span class="absolute inset-0 grid place-items-center">
                  <span class="grid size-16 place-items-center rounded-full bg-accent text-white shadow-[0_10px_30px_-8px_rgba(13,148,136,0.6)] transition-transform duration-200 group-hover:scale-105 group-active:scale-95">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M8 5.5v13l10-6.5-10-6.5Z" />
                    </svg>
                  </span>
                </span>
              </button>
            </div>
            <p class="mt-2 text-xs text-ink3">
              Prefer watching?{' '}
              <a href={`https://youtu.be/${frontmatter.youtube}`} target="_blank" rel="noopener" class="text-accent underline underline-offset-2">
                Watch on YouTube
              </a>{' '}
              and follow the channel for new guides.
            </p>
          </div>
        )
      }

      <div class="guide-prose mt-8 max-w-[70ch]">
        <slot />
      </div>

      {
        tool && (
          <aside class="mt-12 flex max-w-[70ch] flex-col items-start gap-4 rounded-xl border border-line bg-surface p-6 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="font-medium">Ready to try it?</p>
              <p class="mt-1 text-sm text-ink2">
                Open the {tool.name} — free, no signup, nothing uploaded.
              </p>
            </div>
            <a href={`/${tool.slug}`} class="btn btn-primary shrink-0">
              Open {tool.shortName}
              <Icon name="convert" size={16} />
            </a>
          </aside>
        )
      }

      <p class="mt-10 max-w-[70ch] text-sm text-ink3">
        More hands-on walkthroughs in
        <a href="/guides" class="text-accent underline underline-offset-2 hover:underline">all guides</a>.
      </p>
    </article>
  </div>

  <script is:inline>
    // YouTube facade: swap in the iframe only when the visitor clicks, so the
    // page never loads third-party embed JavaScript by default
    document.querySelectorAll('[data-yt-play]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-yt-play');
        if (!id) return;
        const frame = document.createElement('iframe');
        frame.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
        frame.title = 'Video guide';
        frame.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
        frame.allowFullscreen = true;
        frame.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0';
        btn.replaceWith(frame);
      });
    });
  </script>
</Base>
