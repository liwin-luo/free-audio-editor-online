---
/**
 * Layout for /guides/ articles (Astro markdown pages).
 * Frontmatter: title, description, tool (slug for the CTA card), date.
 */
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import { getTool } from '../data/tools';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    tool?: string;
    date?: string;
    audio?: string;
  };
  /** Markdown file url, e.g. "/guides/how-to-cut-a-song" */
  file: string;
}

const { frontmatter, file } = Astro.props;
const path = file.replace(/\.(md|mdx)$/, '');
const tool = frontmatter.tool ? getTool(frontmatter.tool) : undefined;
const date = frontmatter.date ?? '2026-10-14';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: frontmatter.title,
    description: frontmatter.description,
    datePublished: date,
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    mainEntityOfPage: new URL(path, SITE.url).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides', SITE.url).href },
      { '@type': 'ListItem', position: 3, name: frontmatter.title, item: new URL(path, SITE.url).href },
    ],
  },
];
---

<Base title={`${frontmatter.title} — Free Audio Editor`} description={frontmatter.description} path={path} jsonLd={jsonLd} ogType="article">
  <div class="container-page">
    <nav aria-label="Breadcrumb" class="pt-5 text-xs">
      <a href="/" class="text-ink3 hover:text-accent">Home</a>
      <span class="mx-1.5 text-ink3">/</span>
      <a href="/guides" class="text-ink3 hover:text-accent">Guides</a>
      <span class="mx-1.5 text-ink3">/</span>
      <span class="text-ink2" aria-current="page">{frontmatter.title}</span>
    </nav>

    <article class="py-8">
      <header class="max-w-[70ch]">
        <h1 class="text-3xl font-semibold leading-tight tracking-tight md:text-4xl">{frontmatter.title}</h1>
        <p class="mt-3 text-sm text-ink3">
          <time datetime={date}>{new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          · Free Audio Editor Guides
        </p>
        {
          frontmatter.audio && (
            <div class="mt-5 flex items-center gap-3 rounded-xl border border-line bg-surface px-4 py-3">
              <span class="text-sm font-medium text-ink2">Listen</span>
              <audio controls preload="none" src={frontmatter.audio} class="h-10 w-full max-w-md" />
              <span class="hidden text-xs text-ink3 sm:block">or watch the video version on YouTube</span>
            </div>
          )
        }
      </header>

      <div class="guide-prose mt-8 max-w-[70ch]">
        <slot />
      </div>

      {
        tool && (
          <aside class="mt-12 flex max-w-[70ch] flex-col items-start gap-4 rounded-xl border border-line bg-surface p-6 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="font-medium">Ready to try it?</p>
              <p class="mt-1 text-sm text-ink2">
                Open the {tool.name} — free, no signup, nothing uploaded.
              </p>
            </div>
            <a href={`/${tool.slug}`} class="btn btn-primary shrink-0">
              Open {tool.shortName}
              <Icon name="convert" size={16} />
            </a>
          </aside>
        )
      }

      <p class="mt-10 max-w-[70ch] text-sm text-ink3">
        More hands-on walkthroughs in
        <a href="/guides" class="text-accent underline underline-offset-2 hover:underline">all guides</a>.
      </p>
    </article>
  </div>
</Base>
