---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { TOOLS } from '../data/tools';
import { LOCALES, localePath } from '../i18n/locales';
---

<Base
  title="Page not found — Free Audio Editor"
  description="This page does not exist. Head back to the free online audio tools."
  path="/404"
  noindex={true}
>
  <section class="container-page py-24 text-center">
    <p class="font-mono text-sm text-ink3">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl">This page hit a wall of silence</h1>
    <p class="mx-auto mt-3 max-w-[50ch] text-ink2">
      The page you are looking for does not exist — but every audio tool is one click away.
    </p>
    <div class="mx-auto mt-10 grid max-w-3xl gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        TOOLS.map((tool) => (
          <a
            href={`/${tool.slug}`}
            class="flex items-center gap-3 rounded-xl border border-line bg-surface px-4 py-3 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
          >
            <Icon name={tool.icon} size={18} class="text-ink3" />
            {tool.name}
          </a>
        ))
      }
    </div>
    <a href="/" class="btn btn-secondary mt-10">Back to home</a>
    <p class="mt-8 flex flex-wrap justify-center gap-x-4 gap-y-2 text-sm text-ink3">
      {
        LOCALES.filter((l) => l.id !== 'en').map((l) => (
          <a href={localePath(l.id, '/')} hreflang={l.hreflang} class="hover:text-accent">
            {l.label}
          </a>
        ))
      }
    </p>
  </section>
</Base>
