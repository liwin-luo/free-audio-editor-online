---
import Base from '../layouts/Base.astro';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Privacy Policy',
    url: 'https://free-audio-editor.online/privacy',
  },
];
---

<Base
  title="Privacy Policy — Free Audio Editor"
  description="Privacy policy for free-audio-editor.online: your audio files are processed locally in your browser and never uploaded. No accounts, no tracking of your audio."
  path="/privacy"
  jsonLd={jsonLd}
>
  <article class="container-page py-14">
    <h1 class="text-3xl font-semibold tracking-tight md:text-4xl">Privacy Policy</h1>
    <p class="mt-2 text-sm text-ink3">Last updated: October 14, 2026</p>

    <div class="mt-8 max-w-[70ch] space-y-8 text-[15px] leading-relaxed text-ink2">
      <section>
        <h2 class="text-lg font-semibold text-ink">Your audio files</h2>
        <p class="mt-2">
          Every tool on this site processes audio entirely inside your browser using the
          Web Audio API. Your files are <strong>never uploaded to our servers</strong> —
          there is no upload endpoint. When you close the tab, the decoded audio is gone
          from memory.
        </p>
      </section>
      <section>
        <h2 class="text-lg font-semibold text-ink">What we store</h2>
        <p class="mt-2">
          Nothing about you. The site has no accounts and does not require an email
          address. Your theme preference (light or dark) is saved in your browser's
          localStorage and never leaves your device.
        </p>
      </section>
      <section>
        <h2 class="text-lg font-semibold text-ink">Third parties</h2>
        <p class="mt-2">
          The MP3 encoder (lamejs) is loaded on demand from a public content delivery
          network (jsdelivr) when you first export an MP3. The CDN sees a standard
          library request; it does not receive your audio or any information about it.
          Fonts are served from this site's own domain.
        </p>
      </section>
      <section>
        <h2 class="text-lg font-semibold text-ink">Analytics and advertising</h2>
        <p class="mt-2">
          We measure overall traffic with Vercel Web Analytics, which is cookieless and
          records only aggregate page views — never your identity and never your audio.
          We do not run advertising. If either of these change, this policy will be
          updated first.
        </p>
      </section>
      <section>
        <h2 class="text-lg font-semibold text-ink">Contact</h2>
        <p class="mt-2">
          Questions about this policy? Write to
          <a href="mailto:privacy@free-audio-editor.online" class="text-accent hover:underline">privacy@free-audio-editor.online</a>.
        </p>
      </section>
    </div>
  </article>
</Base>
