---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';

const guides = [
  {
    href: '/guides/how-to-cut-a-song',
    title: 'How to Cut a Song Online (Free, Nothing Uploaded)',
    description:
      'Keep the chorus, lose the intro: a practical walkthrough of cutting songs in your browser, including keep-vs-delete modes and fade tricks.',
    minutes: 4,
  },
  {
    href: '/guides/make-iphone-ringtone',
    title: 'How to Make a Ringtone on iPhone (Free, No Computer Needed)',
    description:
      'From any song to an official iPhone ringtone: build a 40-second clip in the browser, then convert it to M4R with GarageBand or Finder.',
    minutes: 5,
  },
  {
    href: '/guides/merge-songs-one-track',
    title: 'How to Merge Songs into One Track Online',
    description:
      'Combine songs into a single continuous file for DJ sets, workouts or podcasts — ordering, crossfades and export settings explained.',
    minutes: 4,
  },
];
---

<Base
  title="Audio Guides — Cut, Merge & Ringtone Walkthroughs | Free Audio Editor"
  description="Step-by-step guides for working with audio in your browser: cutting songs, making iPhone ringtones and merging tracks — all without uploading your files."
  path="/guides"
  jsonLd={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Audio Guides',
      url: 'https://free-audio-editor.online/guides',
    },
  ]}
>
  <section class="container-page py-14">
    <nav aria-label="Breadcrumb" class="text-xs">
      <a href="/" class="text-ink3 hover:text-accent">Home</a>
      <span class="mx-1.5 text-ink3">/</span>
      <span class="text-ink2" aria-current="page">Guides</span>
    </nav>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight md:text-4xl">Audio guides</h1>
    <p class="mt-3 max-w-[60ch] text-ink2">
      Short, practical walkthroughs for the things people actually do with audio —
      written for browser tools that never upload your files.
    </p>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        guides.map((g) => (
          <a
            href={g.href}
            class="group flex flex-col rounded-xl border border-line bg-surface p-6 transition-colors hover:border-accent"
          >
            <h2 class="font-medium leading-snug group-hover:text-accent">{g.title}</h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink2">{g.description}</p>
            <p class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-accent">
              {g.minutes} min read
              <Icon name="convert" size={15} class="transition-transform group-hover:translate-x-0.5" />
            </p>
          </a>
        ))
      }
    </div>
  </section>
</Base>
