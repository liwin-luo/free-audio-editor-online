---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import { TOOLS } from '../data/tools';
import { websiteSchema, webAppSchema, faqSchema } from '../lib/jsonld';

const homeFaqs = [
  {
    q: 'Is Free Audio Editor really free?',
    a: 'Yes — every tool on this site is free with no signup, no watermark and no daily export cap. Because all processing happens in your own browser, there are no server bills to recover.',
  },
  {
    q: 'How is my audio kept private?',
    a: 'Your files are never uploaded. Decoding, editing and exporting all run locally with the Web Audio API inside your browser tab. You can disconnect from the internet after the page loads and every tool keeps working.',
  },
  {
    q: 'Do I need to install anything?',
    a: 'No. The tools are web apps that run in any modern browser — Chrome, Edge, Firefox or Safari, on desktop and mobile.',
  },
  {
    q: 'Which audio formats are supported?',
    a: 'You can open MP3, WAV, M4A/AAC, OGG, FLAC and WebM audio, and save results as MP3 (128–320 kbps) or lossless WAV.',
  },
];

const jsonLd = [
  websiteSchema(),
  webAppSchema('Free Audio Editor', 'Free online audio editor — cut, trim, merge and edit audio in your browser.'),
  faqSchema(homeFaqs),
];

// Bento matrix: two featured cards (biggest keyword + primary CTA target),
// the rest as a compact card flow.
const FEATURED_SLUGS = ['mp4-to-mp3', 'audio-trimmer'];
const featured = FEATURED_SLUGS.map((slug) => TOOLS.find((t) => t.slug === slug)!);
const rest = TOOLS.filter((t) => !FEATURED_SLUGS.includes(t.slug));
---

<Base
  title="Free Audio Editor — Edit Audio Online, Nothing Uploaded"
  description="Free online audio editor: trim, cut, merge, reverse and convert audio right in your browser. No signup, no upload — your files never leave your device."
  path="/"
  jsonLd={jsonLd}
>
  <!-- Hero — left aligned -->
  <section class="container-page pb-12 pt-14 md:pb-16 md:pt-20">
    <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 text-xs font-medium text-ink2">
      <Icon name="shield-check" size={14} class="text-accent" />
      100% local processing · nothing uploaded
    </p>
    <h1 class="mt-5 max-w-[16ch] text-4xl font-semibold leading-[1.05] tracking-tighter md:text-6xl">
      Free online audio editor
    </h1>
    <p class="mt-5 max-w-[55ch] text-lg leading-relaxed text-ink2">
      Trim, cut, merge and edit audio right in your browser. No signup, no watermarks, no
      uploads — your files never leave your device.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href="/audio-trimmer" class="btn btn-primary btn-lg">
        Trim an audio file
        <Icon name="convert" size={18} />
      </a>
      <a href="/audio-joiner" class="btn btn-secondary btn-lg">Merge songs together</a>
    </div>
  </section>

  <!-- Tool matrix — bento: featured cards + compact flow -->
  <section id="tools" class="container-wide pb-16" aria-labelledby="tools-heading">
    <h2 id="tools-heading" class="text-2xl font-semibold tracking-tight md:text-3xl">All audio tools</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
      {
        featured.map((tool) => (
          <a
            href={`/${tool.slug}`}
            class="group relative flex flex-col rounded-xl border border-accent/60 bg-surface p-6 transition-colors hover:border-accent sm:col-span-2 lg:col-span-3"
          >
            <span class="absolute right-5 top-5 inline-flex items-center gap-1.5 rounded-full bg-accent-soft px-2.5 py-1 text-[11px] font-medium text-accent">
              <Icon name="trending-up" size={12} />
              Most used
            </span>
            <span class="grid size-12 place-items-center rounded-xl bg-accent-soft text-accent">
              <Icon name={tool.icon} size={24} />
            </span>
            <h3 class="mt-5 text-lg font-medium group-hover:text-accent">{tool.name}</h3>
            <p class="mt-1.5 flex-1 text-sm leading-relaxed text-ink2">{tool.subtitle}</p>
            <p class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-accent">
              Open {tool.name}
              <Icon name="convert" size={15} class="transition-transform group-hover:translate-x-0.5" />
            </p>
          </a>
        ))
      }
      {
        rest.map((tool) => (
          <a
            href={`/${tool.slug}`}
            class="group flex flex-col rounded-xl border border-line bg-surface p-6 transition-colors hover:border-accent lg:col-span-2"
          >
            <span class="grid size-11 place-items-center rounded-xl bg-accent-soft text-accent">
              <Icon name={tool.icon} size={22} />
            </span>
            <h3 class="mt-5 font-medium group-hover:text-accent">{tool.name}</h3>
            <p class="mt-1.5 flex-1 text-sm leading-relaxed text-ink2">{tool.subtitle}</p>
            <p class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-accent">
              Open {tool.name}
              <Icon name="convert" size={15} class="transition-transform group-hover:translate-x-0.5" />
            </p>
          </a>
        ))
      }
      <div class="flex flex-col justify-center rounded-xl border border-dashed border-line p-6 lg:col-span-2">
        <h3 class="font-medium text-ink2">Coming next</h3>
        <p class="mt-1.5 text-sm leading-relaxed text-ink2">
          Crossfade mixer, silence remover and more — same privacy-first approach.
        </p>
      </div>
    </div>
  </section>

  <!-- Why local -->
  <section class="border-y border-line bg-surface py-16" aria-labelledby="why-heading">
    <div class="container-page">
      <h2 id="why-heading" class="text-2xl font-semibold tracking-tight md:text-3xl">
        Why audio editing belongs on your device
      </h2>
      <div class="mt-8 grid gap-8 md:grid-cols-[2fr_1fr_1fr]">
        <div>
          <span class="grid size-11 place-items-center rounded-xl bg-accent-soft text-accent">
            <Icon name="lock-simple" size={22} />
          </span>
          <h3 class="mt-5 font-medium">Private by design</h3>
          <p class="mt-2 max-w-[45ch] text-sm leading-relaxed text-ink2">
            Voice memos, interviews, unreleased tracks — audio is personal. Here it is
            decoded and edited in your own browser memory. There is no server that could
            see, store or leak it.
          </p>
        </div>
        <div>
          <span class="grid size-11 place-items-center rounded-xl bg-accent-soft text-accent">
            <Icon name="clock-counter-clockwise" size={22} />
          </span>
          <h3 class="mt-5 font-medium">No queue, no waiting</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink2">
            Uploading a 50 MB track, waiting for a server, downloading it back — skipped
            entirely. Editing starts the moment you drop a file.
          </p>
        </div>
        <div>
          <span class="grid size-11 place-items-center rounded-xl bg-accent-soft text-accent">
            <Icon name="check" size={22} />
          </span>
          <h3 class="mt-5 font-medium">Free, really</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink2">
            Local processing costs almost nothing to run, so the tools are free without
            watermarks, signup walls or export limits.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Faq faqs={homeFaqs} />
</Base>
