    "check:smoke": "node scripts/smoke-test.mjs",
    "check:pitch": "node_modules/.bin/esbuild scripts/pitch-check.mjs --bundle --platform=node --format=esm --outfile=/tmp/pitch-check.mjs && node /tmp/pitch-check.mjs",
    "check:waveform": "node_modules/.bin/esbuild scripts/waveform-range-check.mjs --bundle --platform=node --format=esm --outfile=/tmp/waveform-range-check.mjs && node /tmp/waveform-range-check.mjs",
