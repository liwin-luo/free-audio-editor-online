{
  "name": "free-audio-editor-online",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "audit": "node scripts/seo-audit.mjs https://freeaudioeditor.online",
    "audit:preview": "node scripts/seo-audit.mjs http://localhost:4321",
    "check:serp": "node scripts/serp-check.mjs",
    "check:pages": "node scripts/pages-check.mjs",
    "check:features": "node scripts/feature-check.mjs",
    "check:smoke": "node scripts/smoke-test.mjs",
    "check:pitch": "node_modules/.bin/esbuild scripts/pitch-check.mjs --bundle --platform=node --format=esm --outfile=/tmp/pitch-check.mjs && node /tmp/pitch-check.mjs",
    "check:waveform": "node_modules/.bin/esbuild scripts/waveform-range-check.mjs --bundle --platform=node --format=esm --outfile=/tmp/waveform-range-check.mjs && node /tmp/waveform-range-check.mjs",
    "check:spectrogram": "node_modules/.bin/esbuild scripts/spectrogram-check.mjs --bundle --platform=node --format=esm --outfile=/tmp/spectrogram-check.mjs && node /tmp/spectrogram-check.mjs",
    "check:srt": "node_modules/.bin/esbuild scripts/srt-check.mjs --bundle --platform=node --format=esm --outfile=/tmp/srt-check.mjs && node /tmp/srt-check.mjs",
    "check:tags": "node_modules/.bin/esbuild scripts/tags-check.mjs --bundle --platform=node --format=esm --outfile=/tmp/tags-check.mjs && node /tmp/tags-check.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.0",
    "@breezystack/lamejs": "^1.2.7",
    "@fontsource-variable/geist": "^5.1.0",
    "@fontsource-variable/geist-mono": "^5.1.0",
    "@huggingface/transformers": "^3.8.1",
    "@vercel/analytics": "^2.0.1",
    "astro": "^5.1.0",
    "browser-id3-writer": "^6.4.0",
    "mp4-muxer": "^5.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.0.0",
    "image-size": "^2.0.4",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
