{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local editor window. Save-dialog paths are scoped by the dialog plugin.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:4321/*", "http://localhost:4321/*"]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-save",
    "fs:allow-write-file"
  ]
}
