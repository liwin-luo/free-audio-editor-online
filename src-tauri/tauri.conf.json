{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Free Audio Editor",
  "version": "0.1.0",
  "identifier": "online.freeaudioeditor.desktop",
  "build": {
    "beforeDevCommand": "DESKTOP=1 npm run dev",
    "devUrl": "http://127.0.0.1:4321",
    "beforeBuildCommand": "DESKTOP=1 npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Free Audio Editor",
        "width": 1100,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
